<UserControl x:Class="DarkGreyRPG.Studio.Views.DialogueEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Margin="12,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SaveStateText}" />
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding DisplayName}" />
            </DockPanel>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="85" /><ColumnDefinition Width="120" /><ColumnDefinition Width="10" /><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Dialogue ID" />
                <TextBox Grid.Column="1" Padding="7,4" IsReadOnly="True" Text="{Binding Id, Mode=OneWay}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="显示名称" />
                <TextBox Grid.Column="4" Padding="7,4" AutomationProperties.Name="Dialogue 显示名称" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <WrapPanel>
                    <Button Margin="0,0,6,6" Padding="9,5" Command="{Binding AddLineCommand}" Content="+ 台词" AutomationProperties.Name="添加台词" />
                    <Button Margin="0,0,6,6" Padding="9,5" Command="{Binding AddChoiceCommand}" Content="+ 选择" AutomationProperties.Name="添加选择" />
                    <Button Margin="0,0,6,6" Padding="9,5" Command="{Binding AddEndCommand}" Content="+ 出口" AutomationProperties.Name="添加命名出口" />
                </WrapPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" BorderThickness="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Dialogue 节点列表">
                    <ListBox.ItemTemplate><DataTemplate><Border Margin="0,0,0,6" Padding="10" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"><DockPanel><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Text="{Binding TypeLabel}" /><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Id}" /><TextBlock Margin="0,3,40,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Result}" /><Style.Triggers><DataTrigger Binding="{Binding IsLine}" Value="True"><Setter Property="Text" Value="{Binding Text}" /></DataTrigger><DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Text" Value="{Binding Prompt}" /></DataTrigger><DataTrigger Binding="{Binding IsJump}" Value="True"><Setter Property="Text" Value="{Binding Target}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="4" Orientation="Horizontal">
                    <Button Width="64" Margin="0,0,6,0" Command="{Binding MoveNodeUpCommand}" Content="上移" />
                    <Button Width="64" Margin="0,0,6,0" Command="{Binding MoveNodeDownCommand}" Content="下移" />
                    <Button Width="64" Command="{Binding DeleteNodeCommand}" Content="删除" />
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="入口节点" /><ComboBox Grid.Column="1" Padding="7,4" ItemsSource="{Binding Nodes}" DisplayMemberPath="Id" SelectedValuePath="Id" SelectedValue="{Binding Entry, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dialogue 入口节点" /></Grid>
                    <Border Padding="14" Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="4">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="从左侧选择节点开始编辑。">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedNode}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <StackPanel DataContext="{Binding SelectedNode}">
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <DockPanel Margin="0,0,0,12"><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Text="{Binding TypeLabel}" /><TextBlock FontSize="17" FontWeight="SemiBold" Text="节点属性" /></DockPanel>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="节点 ID" /><TextBox Grid.Column="1" Padding="7,4" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                <StackPanel>
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLine}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Speaker" /><TextBox Grid.Column="1" Padding="7,4" AutomationProperties.Name="Dialogue Speaker" Text="{Binding Speaker, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Top" Margin="0,6,0,0" Text="台词" /><TextBox Grid.Column="1" MinHeight="70" Padding="7" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="Dialogue 台词" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="下一节点" /><TextBox Grid.Column="1" Padding="7,4" Text="{Binding Next, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="提示文本" /><TextBox Grid.Column="1" Padding="7,4" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                    <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="玩家选择" />
                                    <ItemsControl ItemsSource="{Binding Choices}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="120" /><ColumnDefinition Width="8" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions><TextBox Padding="7,4" AutomationProperties.Name="Choice Text" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" /><TextBox Grid.Column="2" Padding="7,4" ToolTip="目标 End 节点 ID；End 节点的 Exit Name 是最终命名出口" AutomationProperties.Name="Choice 目标" Text="{Binding Next, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="4" Padding="0" Command="{Binding RemoveCommand}" AutomationProperties.Name="删除 Choice 选项" Content="×" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <Button Width="110" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding AddChoiceOptionCommand}" Content="+ 添加选项" />
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsJump}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="跳转目标" /><TextBox Grid.Column="1" Padding="7,4" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsEnd}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Exit Name" /><TextBox Grid.Column="1" Padding="7,4" AutomationProperties.Name="Dialogue Exit Name" Text="{Binding Result, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                    <TextBlock Margin="90,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="流程编辑器将使用这个命名出口继续连接逻辑。" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Top" Margin="0,6,0,0" Text="备注" /><TextBox Grid.Column="1" MinHeight="58" Padding="7" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="标签" /><TextBox Grid.Column="1" Padding="7,4" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <DockPanel Grid.Row="4"><Button DockPanel.Dock="Right" Width="96" Height="32" Command="{Binding DataContext.SaveCurrentResourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource AccentButtonStyle}" Content="保存" AutomationProperties.Name="保存 Dialogue" /><TextBlock Margin="0,7,12,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Text="{Binding ValidationText}" /></DockPanel>
    </Grid>
</UserControl>
