<Window x:Class="DarkGreyRPG.Studio.Views.WorkspaceCloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存工作区更改"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="WorkspaceCloseDialog">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="当前工作区有未保存的更改。是否在关闭前保存全部更改？"
                   TextWrapping="Wrap"
                   FontSize="14"
                   AutomationProperties.AutomationId="WorkspaceCloseMessage" />
        <StackPanel Grid.Row="1" Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Width="88" Margin="0,0,8,0" Content="保存" IsDefault="True"
                    AutomationProperties.AutomationId="WorkspaceCloseSave"
                    Click="Save_OnClick" />
            <Button x:Name="DiscardButton" Width="88" Margin="0,0,8,0" Content="不保存"
                    AutomationProperties.AutomationId="WorkspaceCloseDiscard"
                    Click="Discard_OnClick" />
            <Button x:Name="CancelButton" Width="88" Content="取消" IsCancel="True"
                    AutomationProperties.AutomationId="WorkspaceCloseCancel"
                    Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
