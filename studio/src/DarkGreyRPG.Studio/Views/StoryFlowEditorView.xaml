<UserControl x:Class="DarkGreyRPG.Studio.Views.StoryFlowEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DarkGreyRPG.Studio.Views"
             Focusable="True"
             AutomationProperties.Name="Story Flow 自由节点画布">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="0,0,4,0" Padding="8,4" Click="Zoom100_OnClick" Content="100%" AutomationProperties.Name="流程缩放到百分之百" />
                <Button Margin="0,0,4,0" Padding="8,4" Click="FitAll_OnClick" Content="适应" AutomationProperties.Name="适应全部流程节点" />
                <Button Margin="0,0,4,0" Padding="8,4" Click="ResetView_OnClick" Content="重置" AutomationProperties.Name="重置流程视图" />
                <Button Width="34" Margin="4,0,0,0" Click="ZoomOut_OnClick" Content="−" AutomationProperties.Name="流程缩小" />
                <TextBlock Width="58" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Zoom, StringFormat={}{0:P0}}" />
                <Button Width="34" Margin="0,0,8,0" Click="ZoomIn_OnClick" Content="+" AutomationProperties.Name="流程放大" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SaveStateText}" />
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Button Margin="0,0,5,0" Padding="8,5" Command="{Binding AddStoryStartCommand}" Content="+ 开始" />
                    <Button Margin="0,0,5,0" Padding="8,5" Command="{Binding AddActorInteractCommand}" Content="+ 交互" />
                    <Button Margin="0,0,5,0" Padding="8,5" Command="{Binding AddPlayDialogueCommand}" Content="+ 对话" />
                    <Button Margin="0,0,5,0" Padding="8,5" Command="{Binding AddStartQuestCommand}" Content="+ 开始任务" />
                    <Button Margin="0,0,5,0" Padding="8,5" Command="{Binding AddWaitQuestCompleteCommand}" Content="+ 等待任务" />
                    <Button Margin="0,0,5,0" Padding="8,5" Command="{Binding AddDialogueExitBranchCommand}" Content="+ Exit 分支" />
                    <Button Margin="0,0,5,0" Padding="8,5" Command="{Binding AddEnterStoryCommand}" Content="+ 进入剧情" />
                    <Button Margin="0,0,5,0" Padding="8,5" Command="{Binding AddEndStoryCommand}" Content="+ 结束剧情" />
                    <Button Padding="8,5" Command="{Binding AddEndCommand}" Content="+ 结束" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Grid Grid.Row="2">
            <local:AccessibleBorder x:Name="CanvasViewport" ClipToBounds="True" Background="#14171B" Focusable="True"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5"
                    AutomationProperties.Name="Story Flow 自由节点画布" AutomationProperties.AutomationId="StoryFlowCanvasViewport"
                    MouseWheel="GraphCanvas_OnMouseWheel"
                    PreviewMouseLeftButtonDown="GraphCanvas_OnPreviewMouseLeftButtonDown"
                    PreviewMouseDown="GraphCanvas_OnPreviewMouseDown"
                    PreviewMouseRightButtonDown="GraphCanvas_OnPreviewMouseRightButtonDown"
                    PreviewMouseMove="GraphCanvas_OnPreviewMouseMove">
                <Canvas x:Name="GraphCanvas" Background="Transparent" Focusable="True"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        KeyDown="GraphCanvas_OnKeyDown" />
            </local:AccessibleBorder>
        </Grid>
        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Right" Width="96" Height="32" Command="{Binding DataContext.SaveCurrentResourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource AccentButtonStyle}" Content="保存 Flow" AutomationProperties.Name="保存 Story Flow" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,7,14,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Summary}" />
                <TextBlock Margin="0,7,14,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SaveStateText}" />
                <Button Margin="0,2,4,0" Padding="6,3" Background="Transparent" BorderThickness="0" Click="Problems_OnClick"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.Name="打开当前 Flow 错误">
                    <TextBlock Text="{Binding ErrorCount, StringFormat=错误 {0}}" />
                </Button>
                <Button Margin="0,2,10,0" Padding="6,3" Background="Transparent" BorderThickness="0" Click="Problems_OnClick"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}" AutomationProperties.Name="打开当前 Flow 警告">
                    <TextBlock Text="{Binding WarningCount, StringFormat=警告 {0}}" />
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
