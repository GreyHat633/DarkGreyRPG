<UserControl x:Class="DarkGreyRPG.Studio.Views.Graph.CanonicalGraphNodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DarkGreyRPG.Studio.Views"
             xmlns:graphview="clr-namespace:DarkGreyRPG.Studio.Views.Graph"
             Width="232" MinHeight="92" Focusable="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Border x:Name="NodeBorder" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
            Padding="0" AutomationProperties.AutomationId="CanonicalGraphNodeBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="HeaderDragZone" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="5,5,0,0" Padding="9,6">
                <TextBlock Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" Text="{Binding Node.DisplayName}" TextTrimming="CharacterEllipsis" />
            </Border>
            <Grid Grid.Row="1" Margin="7,6,7,7">
                <Grid.ColumnDefinitions>
                    <!-- Explicit zero minima prevent long labels from widening
                         the star columns and moving the edge anchors. -->
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="InputPortsPanel" Grid.Column="0" />
                <Grid x:Name="OutputPortsPanel" Grid.Column="1" />
                <!-- Choice outputs use one semantic option row containing its
                     paired Flow and Logic endpoints.  The generic output
                     stack remains the projection for every other node type. -->
                <Grid x:Name="ChoicePortsPanel" Grid.Column="1" Visibility="Collapsed" />
            </Grid>
            <Expander x:Name="ParameterInteractiveZone" Grid.Row="2" Margin="7,0,7,7" Header="参数" IsExpanded="True"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="CanonicalNodeParameterSummary">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InlineEditor.HasInlineFields}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <graphview:CanonicalInlineNodeEditorControl Margin="3,4,3,1" Editor="{Binding InlineEditor}">
                    <graphview:CanonicalInlineNodeEditorControl.Style>
                        <Style TargetType="graphview:CanonicalInlineNodeEditorControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </graphview:CanonicalInlineNodeEditorControl.Style>
                </graphview:CanonicalInlineNodeEditorControl>
            </Expander>
        </Grid>
    </Border>
</UserControl>
