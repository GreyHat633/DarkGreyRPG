<UserControl x:Class="DarkGreyRPG.Studio.Views.Graph.CanonicalGraphNodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DarkGreyRPG.Studio.Views"
             xmlns:graphview="clr-namespace:DarkGreyRPG.Studio.Views.Graph"
             Width="232" MinHeight="92" Focusable="True">
    <Border x:Name="NodeBorder" Background="#25292F" BorderBrush="#59616D" BorderThickness="1" CornerRadius="6"
            Padding="0" AutomationProperties.AutomationId="CanonicalGraphNodeBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="#2D7DAA" CornerRadius="5,5,0,0" Padding="9,6">
                <TextBlock Foreground="White" FontWeight="SemiBold" Text="{Binding Node.DisplayName}" TextTrimming="CharacterEllipsis" />
            </Border>
            <Grid Grid.Row="1" Margin="7,6,7,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="InputPortsPanel" Grid.Column="0" />
                <StackPanel x:Name="OutputPortsPanel" Grid.Column="1" HorizontalAlignment="Right" />
            </Grid>
            <Expander Grid.Row="2" Margin="7,0,7,7" Header="参数" IsExpanded="True"
                      AutomationProperties.AutomationId="CanonicalNodeParameterSummary">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Node.HasParameterSummary}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <TextBlock Margin="3,4,3,1" Foreground="#C8D8E8" FontSize="11"
                           Text="{Binding Node.ParameterSummary}" TextWrapping="Wrap" />
            </Expander>
        </Grid>
    </Border>
</UserControl>
