<UserControl x:Class="DarkGreyRPG.Studio.Views.Graph.AnimatedSection" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:graph="clr-namespace:DarkGreyRPG.Studio.Views.Graph">
 <StackPanel>
  <ToggleButton Content="{Binding Header, ElementName=Root}" IsChecked="{Binding IsExpanded, ElementName=Root, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6">
   <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ContentPresenter VerticalAlignment="Center"/>
      <Path x:Name="Arrow" Grid.Column="1" Data="M 0,0 L 6,6 L 12,0" Width="12" Height="6" Margin="12,0,2,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Data" Value="M 0,6 L 6,0 L 12,6"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></ToggleButton.Template>
  </ToggleButton>
  <graph:AnimatedLinePageBody x:Name="ExpansionBody" IsExpanded="{Binding IsExpanded, ElementName=Root}"><ContentPresenter Content="{Binding Body, ElementName=Root}" Margin="0,6,0,0"/></graph:AnimatedLinePageBody>
 </StackPanel>
</UserControl>
