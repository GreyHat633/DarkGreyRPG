<UserControl x:Class="DarkGreyRPG.Studio.Views.Graph.ReorderEntriesEditor" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:graph="clr-namespace:DarkGreyRPG.Studio.Views.Graph">
 <ItemsControl Background="Transparent" ItemsSource="{Binding ItemsSource, ElementName=Root}">
  <ItemsControl.ItemTemplate><DataTemplate>
   <Border CornerRadius="4"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsDynamicContent, ElementName=Root}" Value="True"><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#727272"/><Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,0,0,10"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel>
   <DockPanel><DockPanel.Style><Style TargetType="DockPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDynamicContent, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
    <Button DockPanel.Dock="Left" Content="⠿" Padding="4,1" Margin="0,0,4,6" VerticalAlignment="Center" graph:EntryReorder.IsHandle="True" ToolTip="拖动调整选项顺序"/>
   <graph:FoldHeader Title="{Binding Caption}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,6"><graph:FoldHeader.Style><Style TargetType="graph:FoldHeader"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDynamicContent, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></graph:FoldHeader.Style></graph:FoldHeader></DockPanel>
   <graph:AnimatedLinePageBody><graph:AnimatedLinePageBody.Style><Style TargetType="graph:AnimatedLinePageBody"><Setter Property="IsExpanded" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsDynamicContent, ElementName=Root}" Value="True"><Setter Property="IsExpanded" Value="{Binding IsExpanded}"/></DataTrigger></Style.Triggers></Style></graph:AnimatedLinePageBody.Style>
   <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Button Grid.Column="0" Content="⠿" Padding="4,1" Margin="0,0,4,0" VerticalAlignment="Center" graph:EntryReorder.IsHandle="True" ToolTip="拖动调整顺序"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsDynamicContent, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <TextBox Grid.Column="1" Text="{Binding EditorText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsDynamicContent, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
    <graph:DynamicContentEditor Grid.Column="1" Text="{Binding EditorText, Mode=TwoWay}"><graph:DynamicContentEditor.Style><Style TargetType="graph:DynamicContentEditor"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDynamicContent, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></graph:DynamicContentEditor.Style></graph:DynamicContentEditor>
    <Button Grid.Column="2" Content="−" Padding="4,1" Margin="3,0,0,0" VerticalAlignment="Center" Command="{Binding RemoveCommand}" ToolTip="删除条目"/>
    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDynamicContent, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <CheckBox Content="前置条件" IsChecked="{Binding ConditionEnabled}"/>
     <graph:AnimatedLinePageBody IsExpanded="{Binding ConditionEnabled}"><StackPanel>
      <CheckBox Content="置灰" IsChecked="{Binding DisableWhenFalse}" Margin="0,3"/>
      <TextBlock Text="置灰后，即使前置条件不满足，该选项依然可见。" graph:AuthoringText.IsHelp="True"/>
      <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DisableWhenFalse}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
       <TextBlock Text="不可选择说明"/><TextBox Text="{Binding UnavailableHint, UpdateSourceTrigger=LostFocus}"/>
      </StackPanel>
     </StackPanel></graph:AnimatedLinePageBody>
    </StackPanel>
   </Grid></graph:AnimatedLinePageBody></StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate>
 </ItemsControl>
</UserControl>
