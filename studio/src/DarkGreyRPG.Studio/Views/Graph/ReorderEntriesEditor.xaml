<UserControl x:Class="DarkGreyRPG.Studio.Views.Graph.ReorderEntriesEditor" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:graph="clr-namespace:DarkGreyRPG.Studio.Views.Graph">
 <ItemsControl Background="Transparent" ItemsSource="{Binding ItemsSource, ElementName=Root}">
  <ItemsControl.ItemTemplate><DataTemplate>
   <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Content="⠿" Padding="4,1" Margin="0,0,4,0" VerticalAlignment="Center" graph:EntryReorder.IsHandle="True" ToolTip="拖动调整顺序"/>
    <TextBox Grid.Column="1" Text="{Binding EditorText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
    <Button Grid.Column="2" Content="−" Padding="4,1" Margin="3,0,0,0" VerticalAlignment="Center" Command="{Binding RemoveCommand}" ToolTip="删除条目"/>
   </Grid>
  </DataTemplate></ItemsControl.ItemTemplate>
 </ItemsControl>
</UserControl>
