<UserControl x:Class="DarkGreyRPG.Studio.Views.Graph.StoryRepeatEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:graph="clr-namespace:DarkGreyRPG.Studio.Views.Graph">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhen"/></UserControl.Resources>
 <StackPanel Margin="0,0,0,10">
   <TextBlock Text="重复设置" FontWeight="SemiBold" Margin="0,0,0,6"/>
   <Border BorderBrush="#727272" BorderThickness="1" CornerRadius="4" Padding="8"
           Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
    <StackPanel>
   <TextBlock Text="重复条件" Margin="0,0,0,4"/>
   <ComboBox x:Name="RepeatChoice" ItemsSource="{Binding RepeatModes}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding RepeatMode}" AutomationProperties.AutomationId="RepeatMode"/>
     <graph:AnimatedNaturalHeightBody x:Name="Details"><StackPanel VerticalAlignment="Top">
     <StackPanel Margin="0,6,0,0" Visibility="{Binding IsRepeatCooldown, Converter={StaticResource VisibleWhen}}">
      <TextBlock Text="冷却时间"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
       <TextBox Text="{Binding RepeatValue, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RepeatValue" Margin="0,0,6,0"/>
       <ComboBox Grid.Column="1" ItemsSource="{Binding RepeatUnits}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding RepeatUnit}"/>
      </Grid>
      <TextBlock graph:AuthoringText.IsHelp="True" Text="从整个故事正常完成后开始计时。离线时间计入冷却。" Margin="0,4,0,0"/>
     </StackPanel>
     <StackPanel Margin="0,6,0,0" Visibility="{Binding IsRepeatScheduled, Converter={StaticResource VisibleWhen}}">
      <TextBlock Text="时间规则"/>
      <ComboBox ItemsSource="{Binding RepeatPeriods}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding RepeatPeriod}"/>
      <StackPanel Visibility="{Binding IsRepeatWeekly, Converter={StaticResource VisibleWhen}}" Margin="0,6,0,0">
       <TextBlock Text="星期"/><ComboBox ItemsSource="{Binding RepeatWeekdays}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding RepeatWeekday}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding IsRepeatYearly, Converter={StaticResource VisibleWhen}}" Margin="0,6,0,0">
       <TextBlock Text="月 / 日"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBox Text="{Binding RepeatMonth, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="1" Text="/" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBox Grid.Column="2" Text="{Binding RepeatDay, UpdateSourceTrigger=PropertyChanged}"/>
       </Grid>
      </StackPanel>
      <TextBlock Text="时间（HH:mm）" Margin="0,6,0,0"/><TextBox Text="{Binding RepeatTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RepeatTime"/>
      <TextBlock graph:AuthoringText.IsHelp="True" Text="使用服务器现实时间；到时仅恢复资格，仍需满足启动条件。" Margin="0,4,0,0"/>
     </StackPanel></StackPanel></graph:AnimatedNaturalHeightBody>
     <TextBlock Text="{Binding RepeatError}" TextWrapping="Wrap" Foreground="OrangeRed" Margin="0,4,0,0"/>
    </StackPanel>
   </Border>
 </StackPanel>
</UserControl>
