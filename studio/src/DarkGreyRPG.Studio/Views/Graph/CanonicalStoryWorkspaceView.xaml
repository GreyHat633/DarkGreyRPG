<UserControl x:Class="DarkGreyRPG.Studio.Views.Graph.CanonicalStoryWorkspaceView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:graph="clr-namespace:DarkGreyRPG.Studio.Views.Graph"
             xmlns:vm="clr-namespace:DarkGreyRPG.Studio.ViewModels.Graph"
             AutomationProperties.AutomationId="CanonicalStoryWorkspace">
    <UserControl.Resources>
        <graph:CanonicalStorySelectionEqualityConverter x:Key="CanonicalStorySelectionEqualityConverter" />
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <EventSetter Event="PreviewKeyDown" Handler="DraftTextBox_OnPreviewKeyDown" />
        </Style>
        <Style x:Key="InstantFolderExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle" HorizontalContentAlignment="Stretch"
                                          FocusVisualStyle="{x:Null}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Padding="3,4" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Width="6" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0,0 L 6,5 L 0,10 Z" Fill="{TemplateBinding Foreground}"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid DataContext="{Binding Workspace, ElementName=Root}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="230" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="280" MinWidth="230" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="12"
                Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="2,0,2,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                   Text="{Binding StoryEditor.DisplayName}"
                                   ToolTip="{Binding StoryEditor.DisplayName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding StoryEditor.Id}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="26" Height="26" Margin="2,0,0,0" Padding="6"
                                Command="{Binding CreateSelectedResourceCommand}"
                                ToolTip="在所选文件夹中新建资源"
                                AutomationProperties.AutomationId="CanonicalCreateResource"
                                AutomationProperties.Name="新建资源">
                            <Viewbox><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 8,2 L 8,14 M 2,8 L 14,8" /></Canvas></Viewbox>
                        </Button>
                        <Button Width="26" Height="26" Margin="2,0,0,0" Padding="6"
                                Command="{Binding ReferenceSelectedResourceCommand}"
                                ToolTip="引用已有资源"
                                AutomationProperties.AutomationId="CanonicalReferenceResource"
                                AutomationProperties.Name="引用已有资源">
                            <Viewbox><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" Data="M 6.2,5.2 L 8.8,2.6 C 10.4,1 13,1 14.5,2.5 C 16,4 16,6.6 14.4,8.2 L 11.8,10.8 M 9.8,10.8 L 7.2,13.4 C 5.6,15 3,15 1.5,13.5 C 0,12 0,9.4 1.6,7.8 L 4.2,5.2 M 5.5,10.5 L 10.5,5.5" /></Canvas></Viewbox>
                        </Button>
                        <Button Width="26" Height="26" Margin="2,0,0,0" Padding="6"
                                Command="{Binding DeleteSelectedResourceCommand}"
                                ToolTip="删除资源或解除引用"
                                AutomationProperties.AutomationId="CanonicalDeleteResource"
                                AutomationProperties.Name="删除资源或解除引用">
                            <Viewbox><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round" Data="M 3,5 L 13,5 M 6,2 L 10,2 L 11,5 M 4,5 L 5,14 L 11,14 L 12,5 M 7,7 L 7,12 M 9,7 L 9,12" /></Canvas></Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CanonicalStoryFolderViewModel}">
                                <Expander Margin="0,2" Style="{StaticResource InstantFolderExpanderStyle}"
                                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <TextBlock Padding="2,1" Text="{Binding DisplayName}" Tag="{Binding}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   PreviewMouseLeftButtonDown="Folder_OnPreviewMouseLeftButtonDown"
                                                   PreviewMouseRightButtonDown="Folder_OnPreviewMouseRightButtonDown" />
                                    </Expander.Header>
                                    <ItemsControl Margin="10,2,0,6" ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,1" Padding="8,4"
                                                        HorizontalContentAlignment="Stretch"
                                                        AllowDrop="True"
                                                        Tag="{Binding}"
                                                        Click="ResourceItem_OnClick"
                                                        MouseDoubleClick="ResourceItem_OnMouseDoubleClick"
                                                        PreviewMouseLeftButtonDown="ResourceItem_OnPreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="ResourceItem_OnPreviewMouseMove"
                                                        DragOver="ResourceItem_OnDragOver"
                                                        DragLeave="ResourceItem_OnDragLeave"
                                                        Drop="ResourceItem_OnDrop"
                                                        PreviewMouseRightButtonDown="ResourceItem_OnPreviewMouseRightButtonDown"
                                                        KeyDown="ResourceItem_OnKeyDown">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Padding="{TemplateBinding Padding}"
                                                                                Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="4">
                                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                                              RecognizesAccessKey="True" />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Opacity" Value="0.56" />
                                                                </Trigger>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource CanonicalStorySelectionEqualityConverter}">
                                                                            <Binding />
                                                                            <Binding Path="Workspace.SelectedTreeItem"
                                                                                     RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                                        <Condition Value="True">
                                                                            <Condition.Binding>
                                                                                <MultiBinding Converter="{StaticResource CanonicalStorySelectionEqualityConverter}">
                                                                                    <Binding />
                                                                                    <Binding Path="Workspace.SelectedTreeItem"
                                                                                             RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                                                </MultiBinding>
                                                                            </Condition.Binding>
                                                                        </Condition>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                   Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"
                                                                   Text="{Binding IdentityText}" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                                                        <DataTrigger Value="True">
                                                                            <DataTrigger.Binding>
                                                                                <MultiBinding Converter="{StaticResource CanonicalStorySelectionEqualityConverter}">
                                                                                    <Binding />
                                                                                    <Binding Path="Workspace.SelectedTreeItem"
                                                                                             RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                                                </MultiBinding>
                                                                            </DataTrigger.Binding>
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Padding="10,7" Background="{DynamicResource LayerFillColorAltBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CanonicalStoryBreadcrumb}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="3,0" VerticalAlignment="Center" Text=">">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Padding="5,2" Background="Transparent" BorderBrush="Transparent"
                                        Tag="{Binding}" Click="Breadcrumb_OnClick"
                                        Content="{Binding DisplayName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Grid Grid.Row="1">
                <graph:CanonicalGraphEditorView x:Name="WorkspaceGraph" Host="{Binding ActiveGraphHost}"
                                                ViewportState="{Binding ActiveEditor.ViewportState}"
                                                AllowDrop="True" DragOver="WorkspaceGraph_OnDragOver"
                                                DragLeave="WorkspaceGraph_OnDragLeave" Drop="WorkspaceGraph_OnDrop"
                                                AutomationProperties.AutomationId="CanonicalStoryWorkspaceGraph" />
                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                    <Border x:Name="ResourceDragGhost" Width="232" MinHeight="92" Visibility="Collapsed"
                            Opacity="0.78" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderThickness="2" CornerRadius="6"
                            AutomationProperties.AutomationId="CanonicalResourceDragGhost">
                        <StackPanel>
                            <Border Padding="9,6" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4,4,0,0">
                                <TextBlock x:Name="ResourceDragGhostTitle" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <TextBlock Margin="9,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="松开以放置节点" />
                        </StackPanel>
                    </Border>
                    <Border Canvas.Left="18" Canvas.Top="18" MaxWidth="420" Padding="10,6"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasParameterDropMessage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ParameterDropMessage}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="CanonicalParameterDropMessage" />
                    </Border>
                </Canvas>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

        <Border Grid.Column="4" Padding="16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding InspectorKindText}" />
                <TextBlock Margin="0,4,0,0" FontSize="19" FontWeight="SemiBold"
                           Text="{Binding InspectorTitle}" TextWrapping="Wrap" />
                <TextBlock FontWeight="SemiBold" Text="{Binding InspectorSaveStateText}" />
                <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding InspectorValidationText}" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="CanonicalInspectorScrollViewer">
                <StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasResourceInspectorDetails}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{Binding InspectorIdentityText}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ResourceInspectorIdentityLine" />
                    <Grid Margin="0,12,0,0"
                          AutomationProperties.AutomationId="ResourceInspectorTagsRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="标签："
                                   AutomationProperties.AutomationId="ResourceInspectorTagsLabel" />
                        <TextBlock Grid.Column="1" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{Binding InspectorTagsText}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ResourceInspectorTagsValue" />
                    </Grid>
                </StackPanel>
                <StackPanel DataContext="{Binding NodeInspector}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasEditableFields}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock FontWeight="SemiBold" Text="节点属性" />
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsStoryStart}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="重复策略" />
                        <ComboBox Margin="0,3,0,0" ItemsSource="{Binding RepeatPolicyChoices}"
                                  SelectedItem="{Binding SelectedRepeatPolicy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayName"
                                  AutomationProperties.AutomationId="StoryStartRepeatPolicy"
                                  AutomationProperties.Name="Story Start repeat policy" />
                        <Grid Margin="0,12,0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="启动条件" />
                            <Button Grid.Column="1" Width="26" Height="24" Padding="5" Command="{Binding AddStoryStartTriggerCommand}"
                                    ToolTip="添加启动条件" AutomationProperties.AutomationId="StoryStartAddTrigger" AutomationProperties.Name="添加启动条件">
                                <Viewbox><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" Data="M 8,2 L 8,14 M 2,8 L 14,8" /></Canvas></Viewbox>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding StoryStartTriggers}" AutomationProperties.AutomationId="StoryStartTriggerList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4" Padding="8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Margin="3,0,0,0" Padding="4,1" Content="↑" Command="{Binding MoveUpCommand}" ToolTip="上移" />
                                                    <Button Margin="2,0,0,0" Padding="4,1" Content="↓" Command="{Binding MoveDownCommand}" ToolTip="下移" />
                                                    <Button Margin="2,0,0,0" Padding="4,1" Content="−" Command="{Binding RemoveCommand}" ToolTip="删除启动条件" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Margin="0,8,0,3" Text="名称" />
                                            <TextBox Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.AutomationId="StoryStartTriggerName" />
                                            <TextBlock Margin="0,8,0,3" Text="类型" />
                                            <ComboBox ItemsSource="{Binding TriggerTypeOptions}"
                                                      SelectedItem="{Binding SelectedTriggerType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="StoryStartTriggerType"
                                                      AutomationProperties.Name="Story Start trigger type" />
                                            <TextBlock Margin="0,4,0,0" Text="将 Story 公共逻辑输入连接到此触发的条件端口。"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLogic}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Margin="0,8,0,3" Text="目标角色" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsActorInteraction}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <ComboBox ItemsSource="{Binding ActorOptions}"
                                                      SelectedItem="{Binding SelectedActor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="DisplayName" AutomationProperties.AutomationId="StoryStartTriggerActorId">
                                                <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsActorInteraction}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                                            </ComboBox>
                                            <StackPanel Margin="0,4,0,0">
                                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsRegionEntry}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                <TextBlock Text="维度" />
                                                <TextBox Text="{Binding DimensionText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.AutomationId="StoryStartTriggerDimension" />
                                                <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding DimensionError}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsRegionEntry}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,2,0"><TextBlock Text="X" /><TextBox Text="{Binding XText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.AutomationId="StoryStartTriggerX" /><TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding XError}" TextWrapping="Wrap" /></StackPanel>
                                                <StackPanel Grid.Column="1" Margin="2,0"><TextBlock Text="Y" /><TextBox Text="{Binding YText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.AutomationId="StoryStartTriggerY" /><TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding YError}" TextWrapping="Wrap" /></StackPanel>
                                                <StackPanel Grid.Column="2" Margin="2,0,0,0"><TextBlock Text="Z" /><TextBox Text="{Binding ZText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.AutomationId="StoryStartTriggerZ" /><TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding ZError}" TextWrapping="Wrap" /></StackPanel>
                                            </Grid>
                                            <StackPanel Margin="0,4,0,0">
                                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsRegionEntry}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                <TextBlock Text="半径" />
                                                <TextBox Text="{Binding RadiusText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.AutomationId="StoryStartTriggerRadius" />
                                                <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding RadiusError}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
