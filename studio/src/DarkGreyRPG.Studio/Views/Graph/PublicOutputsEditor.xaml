<UserControl x:Class="DarkGreyRPG.Studio.Views.Graph.PublicOutputsEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:graph="clr-namespace:DarkGreyRPG.Studio.Views.Graph">
 <UserControl.Style>
  <Style TargetType="UserControl"><Style.Triggers>
   <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
   <DataTrigger Binding="{Binding HasOutputs}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
  </Style.Triggers></Style>
 </UserControl.Style>
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style TargetType="ItemsControl">
   <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Background="Transparent"/></ItemsPanelTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="Row">
   <Grid Margin="0,3">
    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="Transparent" graph:EntryReorder.IsHandle="True" ToolTip="拖动调整顺序"><TextBlock Text="⠿" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
    <TextBox Grid.Column="1" Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}" Visibility="{Binding CanRename, Converter={StaticResource Visible}}"/>
    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Margin="4,7" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding CanRename}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
  </DataTemplate>
 </UserControl.Resources>
 <StackPanel>
  <TextBlock Text="输出端口" Margin="0,8,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
  <Border Margin="0,8,0,2" Padding="8" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Visibility="{Binding HasFlow, Converter={StaticResource Visible}}">
   <graph:AnimatedSection Header="流程输出" IsExpanded="{Binding FlowExpanded, Mode=TwoWay}">
    <StackPanel><TextBlock Text="上方结果优先结算" graph:AuthoringText.IsHelp="True" Visibility="{Binding IsTask, Converter={StaticResource Visible}}"/><ItemsControl ItemsSource="{Binding Flow}" ItemTemplate="{StaticResource Row}"/></StackPanel>
   </graph:AnimatedSection>
  </Border>
  <Border Margin="0,8,0,2" Padding="8" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Visibility="{Binding HasLogic, Converter={StaticResource Visible}}">
   <graph:AnimatedSection Header="逻辑输出" IsExpanded="{Binding LogicExpanded, Mode=TwoWay}"><ItemsControl ItemsSource="{Binding Logic}" ItemTemplate="{StaticResource Row}"/></graph:AnimatedSection>
  </Border>
 </StackPanel>
</UserControl>
