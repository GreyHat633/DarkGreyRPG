<UserControl x:Class="DarkGreyRPG.Studio.Views.Graph.RewardEntriesEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:graph="clr-namespace:DarkGreyRPG.Studio.Views.Graph"
 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhen"/></UserControl.Resources>
 <StackPanel>
  <TextBlock Text="{Binding RewardEntries.Count, StringFormat=奖励内容（共 {0} 条）}" FontWeight="SemiBold"/>
  <TextBlock graph:AuthoringText.IsHelp="True" Text="正数给予，负数扣除，零不操作。每个任务实例只发放一次。" Margin="0,3,0,8"/>
  <ItemsControl ItemsSource="{Binding RewardEntries}" AutomationProperties.AutomationId="TaskRewardEntries">
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border BorderBrush="#727272" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" AutomationProperties.Name="{Binding EntryTitle}">
     <StackPanel>
      <DockPanel Margin="0,0,0,8">
       <Button DockPanel.Dock="Right" Content="删除" Command="{Binding RemoveCommand}" Padding="6,2" Margin="6,0,0,0"
               AutomationProperties.Name="{Binding EntryTitle, StringFormat=删除{0}}" ToolTip="删除这条奖励"/>
       <TextBlock Text="{Binding EntryTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Text="类型" Margin="0,0,0,2"/>
      <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="DisplayName"/>
      <TextBlock Text="数量（增减）" Margin="0,7,0,2"/>
      <TextBox graph:NumericDrag.Step="1" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"/>
      <StackPanel Visibility="{Binding IsItem, Converter={StaticResource VisibleWhen}}" Margin="0,7,0,0">
       <TextBlock Text="物品" Margin="0,0,0,2"/>
       <ComboBox graph:ResourceSelectorDrop.Kind="Item" ItemsSource="{Binding ItemOptions}" SelectedItem="{Binding SelectedItem}" DisplayMemberPath="DisplayName"/>
      </StackPanel>
      <TextBlock Text="{Binding Error}" Foreground="OrangeRed" TextWrapping="Wrap">
       <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
        <DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
       </Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </StackPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <Button Content="+ 添加奖励" Command="{Binding AddRewardEntryCommand}" HorizontalAlignment="Left"/>
 </StackPanel>
</UserControl>
