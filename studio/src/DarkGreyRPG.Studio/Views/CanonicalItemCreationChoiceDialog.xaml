<Window x:Class="DarkGreyRPG.Studio.Views.CanonicalItemCreationChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建物品" Width="500" Height="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="创建物品" />
        <TextBlock Grid.Row="1" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"><Run Text="归入故事："/><Run FontWeight="SemiBold" Text="{Binding StoryDisplayName, Mode=OneWay}"/></TextBlock>
        <StackPanel Grid.Row="3">
            <Border Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5">
                <RadioButton GroupName="ItemKind" IsChecked="{Binding IsIndividual}" AutomationProperties.Name="物品">
                    <StackPanel Margin="8,0,0,0"><TextBlock FontSize="16" FontWeight="SemiBold" Text="物品"/><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="使用精确的 Item ID 匹配一种物品身份。"/></StackPanel>
                </RadioButton>
            </Border>
            <Border Margin="0,12,0,0" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5">
                <RadioButton GroupName="ItemKind" IsChecked="{Binding IsCollective}" AutomationProperties.Name="物品组">
                    <StackPanel Margin="8,0,0,0"><TextBlock FontSize="16" FontWeight="SemiBold" Text="物品组"/><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="使用 Group ID 表示一类可包含多个物品的资源。"/></StackPanel>
                </RadioButton>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="88" Height="32" Margin="0,0,8,0" IsCancel="True" Content="取消"/><Button Width="88" Height="32" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="ContinueButton_OnClick" Content="继续"/></StackPanel>
    </Grid>
</Window>
