<Window x:Class="DarkGreyRPG.Studio.Views.ResourceIdentityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:graph="clr-namespace:DarkGreyRPG.Studio.Views.Graph"
        xmlns:views="clr-namespace:DarkGreyRPG.Studio.Views"
        Title="{Binding Title}" Width="500" Height="360" MinWidth="460" MinHeight="330"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="12" />
            <RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" />
            <RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" />
        <TextBlock Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Description}" />
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="显示名称" />
            <TextBox Grid.Column="1" Padding="8,5" AutomationProperties.Name="显示名称"
                     graph:TextInputWatermark.Text="例如：北境来信" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <TextBlock Grid.Row="8" Margin="90,10,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap" Text="{Binding ValidationText}" />
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Width="88" Height="32" IsDefault="True" IsEnabled="{Binding CanConfirm}"
                    Style="{DynamicResource AccentButtonStyle}" Click="ConfirmButton_OnClick" Content="{Binding ActionText}" />
            <Button Width="88" Height="32" IsCancel="True" Content="取消" />
        </StackPanel>
    </Grid>
</Window>
