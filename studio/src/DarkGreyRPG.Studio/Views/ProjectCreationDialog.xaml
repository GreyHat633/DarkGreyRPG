<Window x:Class="DarkGreyRPG.Studio.Views.ProjectCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="680" Height="360" MinWidth="560" MinHeight="360"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="20" />
            <RowDefinition Height="Auto" /><RowDefinition Height="14" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="14" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" FontSize="22" FontWeight="SemiBold" Text="{Binding Title}" />

        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="项目路径" />
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="NewProjectDestination" Margin="0,0,8,0" Padding="8,5"
                     ToolTip="{Binding FullDestination}"
                     Text="{Binding FullDestination, UpdateSourceTrigger=PropertyChanged}" />
            <Button x:Name="BrowseProjectDestination" Grid.Column="1" Padding="12,5"
                    Content="浏览…" Click="BrowseDestination_OnClick" />
        </Grid>

        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="项目 ID" />
        <TextBox x:Name="NewProjectId" Grid.Row="4" Grid.Column="1" Padding="8,5"
                 Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasSuggestion}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
            </StackPanel.Style>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="建议（点击应用）：" />
            <Button Margin="8,0,0,0" Padding="8,3" Command="{Binding ApplySuggestionCommand}" Content="{Binding NormalizedSuggestion}" />
        </StackPanel>

        <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="显示名称" />
        <TextBox x:Name="NewProjectDisplayName" Grid.Row="7" Grid.Column="1" Padding="8,5"
                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="8" Grid.Column="1" Margin="0,10,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap" Text="{Binding ValidationText}" />

        </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Margin="0,0,8,0" x:Name="CreateProjectButton" Width="110" Height="34" IsDefault="True" IsEnabled="{Binding CanConfirm}"
                    Style="{DynamicResource AccentButtonStyle}" Click="ConfirmButton_OnClick" Content="{Binding ActionText}" />
            <Button Width="96" Height="34" IsCancel="True" Content="取消" />
        </StackPanel>
    </Grid>
</Window>
