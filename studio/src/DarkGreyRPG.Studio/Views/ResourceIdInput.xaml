<UserControl x:Class="DarkGreyRPG.Studio.Views.ResourceIdInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="NameSpace"
                   Text="{Binding NamespacePrefixDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding NamespacePrefix}">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasLockedNamespace}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <TextBox Grid.Column="1" Padding="8,5" AutomationProperties.Name="资源 ID"
                 Text="{Binding EditableId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>
</UserControl>
