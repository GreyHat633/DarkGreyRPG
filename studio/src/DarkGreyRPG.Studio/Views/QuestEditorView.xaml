<UserControl x:Class="DarkGreyRPG.Studio.Views.QuestEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel><TextBlock DockPanel.Dock="Right" Margin="12,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SaveStateText}" /><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding DisplayName}" /></DockPanel>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="125" /><ColumnDefinition Width="10" /><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Quest ID" /><TextBox Grid.Column="1" Padding="7,4" IsReadOnly="True" Text="{Binding Id, Mode=OneWay}" /><TextBlock Grid.Column="3" VerticalAlignment="Center" Text="显示名称" /><TextBox Grid.Column="4" Padding="7,4" AutomationProperties.Name="Quest 显示名称" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" /></Grid>
            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Top" Margin="0,6,0,0" Text="描述" /><TextBox Grid.Column="1" MinHeight="54" Padding="7" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="Quest 描述" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" /></Grid>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <WrapPanel>
                    <Button Margin="0,0,6,6" Padding="9,5" Command="{Binding AddKillCommand}" Content="+ 击杀" AutomationProperties.Name="添加击杀目标" />
                    <Button Margin="0,0,6,6" Padding="9,5" Command="{Binding AddCollectCommand}" Content="+ 收集" AutomationProperties.Name="添加收集目标" />
                    <Button Margin="0,0,6,6" Padding="9,5" Command="{Binding AddInteractCommand}" Content="+ 交互" AutomationProperties.Name="添加交互目标" />
                </WrapPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding Objectives}" SelectedItem="{Binding SelectedObjective}" BorderThickness="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Quest 目标列表">
                    <ListBox.ItemTemplate><DataTemplate><Border Margin="0,0,0,6" Padding="10" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"><DockPanel><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Text="{Binding TypeLabel}" /><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Id}" /><TextBlock Margin="0,3,40,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Description}" /></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="4" Orientation="Horizontal"><Button Width="64" Margin="0,0,6,0" Command="{Binding MoveObjectiveUpCommand}" Content="上移" /><Button Width="64" Margin="0,0,6,0" Command="{Binding MoveObjectiveDownCommand}" Content="下移" /><Button Width="64" Command="{Binding DeleteObjectiveCommand}" Content="删除" AutomationProperties.Name="删除 Quest 目标" /></StackPanel>
            </Grid>
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="完成规则" /><ComboBox Grid.Column="1" Padding="7,4" IsEnabled="{Binding HasObjectives}" ItemsSource="{Binding CompletionModeOptions}" SelectedValuePath="Value" SelectedValue="{Binding CompletionMode, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Label" AutomationProperties.Name="Quest 完成规则" /></Grid>
                    <Border Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsEmptyState}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="这个任务还没有目标。" />
                            <TextBlock Margin="0,6,0,12" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="选择第一个任务目标：" />
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Margin="0,0,6,0" Padding="9,5" Command="{Binding AddFirstKillCommand}" Content="击杀实体" AutomationProperties.Name="第一个目标：击杀实体" />
                                <Button Margin="0,0,6,0" Padding="9,5" Command="{Binding AddFirstCollectCommand}" Content="收集物品" AutomationProperties.Name="第一个目标：收集物品" />
                                <Button Padding="9,5" Command="{Binding AddFirstInteractCommand}" Content="与角色交互" AutomationProperties.Name="第一个目标：与角色交互" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Padding="14" Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="4">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsEmptyState}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <Grid>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="从左侧选择任务目标开始编辑。"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedObjective}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <StackPanel DataContext="{Binding SelectedObjective}">
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <DockPanel Margin="0,0,0,12"><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Text="{Binding TypeLabel}" /><TextBlock FontSize="17" FontWeight="SemiBold" Text="目标属性" /></DockPanel>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="目标 ID" /><TextBox Grid.Column="1" Padding="7,4" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Top" Margin="0,6,0,0" Text="目标描述" /><TextBox Grid.Column="1" MinHeight="54" Padding="7" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                                <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsKill}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="实体 ID" /><TextBox Grid.Column="1" Padding="7,4" AutomationProperties.Name="KillEntity 实体" Text="{Binding Entity, UpdateSourceTrigger=PropertyChanged}" /></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="数量" /><TextBox Grid.Column="1" Padding="7,4" Text="{Binding Required, UpdateSourceTrigger=PropertyChanged}" /></Grid></StackPanel>
                                <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsCollect}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="物品 ID" /><TextBox Grid.Column="1" Padding="7,4" AutomationProperties.Name="CollectItem 物品" Text="{Binding Item, UpdateSourceTrigger=PropertyChanged}" /></Grid><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Metadata" /><TextBox Grid.Column="1" Padding="7,4" Text="{Binding ItemMetadata, UpdateSourceTrigger=PropertyChanged}" /></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="数量" /><TextBox Grid.Column="1" Padding="7,4" Text="{Binding Required, UpdateSourceTrigger=PropertyChanged}" /></Grid></StackPanel>
                                <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsInteract}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="角色" /><ComboBox Grid.Column="1" Padding="7,4" IsEditable="True" ItemsSource="{Binding DataContext.AvailableActorIds, RelativeSource={RelativeSource AncestorType=UserControl}}" Text="{Binding ActorId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="InteractActor 角色" /></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="次数" /><TextBox Grid.Column="1" Padding="7,4" Text="{Binding Required, UpdateSourceTrigger=PropertyChanged}" /></Grid></StackPanel>
                                <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsReach}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="这是旧 Runtime 兼容目标；编辑器会原样保留。" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="维度" /><TextBox Grid.Column="1" Padding="7,4" Text="{Binding Dimension, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Grid.Column="3" VerticalAlignment="Center" Text="半径" /><TextBox Grid.Column="4" Padding="7,4" Text="{Binding Radius, UpdateSourceTrigger=PropertyChanged}" /></Grid></StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding GroupSummary, StringFormat=目标分组：{0}}" />
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Top" Margin="0,6,0,0" Text="备注" /><TextBox Grid.Column="1" MinHeight="54" Padding="7" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="标签" /><TextBox Grid.Column="1" Padding="7,4" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <DockPanel Grid.Row="4"><Button DockPanel.Dock="Right" Width="96" Height="32" Command="{Binding DataContext.SaveCurrentResourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource AccentButtonStyle}" Content="保存" AutomationProperties.Name="保存 Quest" /><TextBlock Margin="0,7,12,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Text="{Binding ValidationText}" /></DockPanel>
    </Grid>
</UserControl>
