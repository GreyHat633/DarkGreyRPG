<Window x:Class="DarkGreyRPG.Studio.Views.ResourceCreationChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="500" Height="360" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Title}" />
        <TextBlock Grid.Row="1" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"><Run Text="归入故事：" /><Run FontWeight="SemiBold" Text="{Binding StoryDisplayName, Mode=OneWay}" /></TextBlock>
        <StackPanel Grid.Row="3">
            <Border Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5">
                <RadioButton GroupName="CreationMode" IsChecked="{Binding IsBlank}" AutomationProperties.Name="空白创建">
                    <StackPanel Margin="8,0,0,0"><TextBlock FontSize="16" FontWeight="SemiBold" Text="空白创建" /><TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"><Run Text="创建新的" /><Run Text="{Binding ChineseTypeLabel, Mode=OneWay}" /><Run Text=" ID 和基础数据。" /></TextBlock></StackPanel>
                </RadioButton>
            </Border>
            <Border Margin="0,12,0,0" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5">
                <RadioButton GroupName="CreationMode" IsChecked="{Binding IsImportAsNew}" AutomationProperties.Name="导入已有资源">
                    <StackPanel Margin="8,0,0,0"><TextBlock FontSize="16" FontWeight="SemiBold" Text="导入已有资源" /><TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="以项目中的资源为模板创建一份独立副本；后续修改互不影响。" /></StackPanel>
                </RadioButton>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="88" Height="32" Margin="0,0,8,0" IsCancel="True" Content="取消" /><Button Width="88" Height="32" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="ContinueButton_OnClick" Content="继续" /></StackPanel>
    </Grid>
</Window>
