<Window x:Class="DarkGreyRPG.Studio.Views.DisplayNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="480" Height="270" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" />
        <TextBlock Grid.Row="1" Margin="0,7,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding IdentityText}" AutomationProperties.Name="稳定资源标识" />
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="显示名称" />
            <TextBox Grid.Column="1" Padding="8,5" AutomationProperties.Name="显示名称"
                     Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <TextBlock Grid.Row="4" Margin="90,8,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Text="{Binding ValidationText}" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="88" Height="32" Margin="0,0,8,0" IsCancel="True" Content="取消" />
            <Button Width="88" Height="32" IsDefault="True" IsEnabled="{Binding CanConfirm}"
                    Style="{DynamicResource AccentButtonStyle}" Click="ConfirmButton_OnClick" Content="保存" />
        </StackPanel>
    </Grid>
</Window>
