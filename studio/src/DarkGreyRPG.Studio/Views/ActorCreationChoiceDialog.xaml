<Window x:Class="DarkGreyRPG.Studio.Views.ActorCreationChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建角色" Width="500" Height="360" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="16" /><RowDefinition Height="*" />
            <RowDefinition Height="18" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="创建角色" />
        <TextBlock Grid.Row="1" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <Run Text="归入剧情：" /><Run FontWeight="SemiBold" Text="{Binding StoryDisplayName, Mode=OneWay}" />
        </TextBlock>
        <StackPanel Grid.Row="3">
            <Border Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5">
                <RadioButton GroupName="CreationMode" IsChecked="{Binding IsBlank}" AutomationProperties.Name="空白创建">
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="空白创建" />
                        <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="创建新的角色 ID 和空白角色数据。" />
                    </StackPanel>
                </RadioButton>
            </Border>
            <Border Margin="0,12,0,0" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5">
                <RadioButton GroupName="CreationMode" IsChecked="{Binding IsImportAsNew}" AutomationProperties.Name="导入已有角色">
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="导入已有角色" />
                        <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="以项目中的角色为模板创建一份独立资源；后续修改不会影响原角色。" />
                    </StackPanel>
                </RadioButton>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="88" Height="32" Margin="0,0,8,0" IsCancel="True" Content="取消" />
            <Button Width="88" Height="32" IsDefault="True" Style="{DynamicResource AccentButtonStyle}"
                    Click="ContinueButton_OnClick" Content="继续" />
        </StackPanel>
    </Grid>
</Window>
