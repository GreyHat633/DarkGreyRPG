<UserControl x:Class="DarkGreyRPG.Studio.Views.ProjectGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" AutomationProperties.Name="剧情图谱自由布局画布">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Width="116" Height="34"
                    Command="{Binding DataContext.ShowProjectHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="返回剧情列表" AutomationProperties.Name="图谱返回剧情列表" />
            <StackPanel Orientation="Horizontal">
                <TextBox Width="170" Margin="0,0,8,0" Padding="8,5" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="搜索剧情图谱" />
                <ComboBox Width="96" Margin="0,0,8,0" Padding="6,4" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}"
                          AutomationProperties.Name="筛选剧情图谱" />
                <Button Margin="0,0,8,0" Padding="10,5" Command="{Binding AutoLayoutCommand}" Content="自动布局" AutomationProperties.Name="剧情图谱自动布局" />
                <Button Width="34" Click="ZoomOut_OnClick" Content="−" AutomationProperties.Name="剧情图谱缩小" />
                <TextBlock Width="58" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Zoom, StringFormat={}{0:P0}}" />
                <Button Width="34" Click="ZoomIn_OnClick" Content="+" AutomationProperties.Name="剧情图谱放大" />
                <TextBlock Width="174" Margin="12,7,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <Border x:Name="CanvasViewport" ClipToBounds="True" Background="#14171B" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5">
                <Canvas x:Name="GraphCanvas" Width="4000" Height="2600" Background="Transparent" Focusable="True"
                        PreviewMouseLeftButtonDown="GraphCanvas_OnPreviewMouseLeftButtonDown"
                        PreviewMouseRightButtonDown="GraphCanvas_OnPreviewMouseRightButtonDown"
                        PreviewMouseMove="GraphCanvas_OnPreviewMouseMove"
                        PreviewMouseUp="GraphCanvas_OnPreviewMouseUp"
                        MouseWheel="GraphCanvas_OnMouseWheel" />
            </Border>
            <Border Grid.Column="2" Padding="12" Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="图谱诊断" />
                    <TextBlock Grid.Row="1" Margin="0,5,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="逻辑由 EnterStory 派生，只能调整布局。" TextWrapping="Wrap" />
                    <ListBox Grid.Row="2" ItemsSource="{Binding Diagnostics}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="剧情图谱诊断列表">
                        <ListBox.ItemTemplate><DataTemplate><Border Margin="0,0,0,7" Padding="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" /></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding PersistenceWarning}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
