<UserControl x:Class="DarkGreyRPG.Studio.Views.ProjectGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DarkGreyRPG.Studio.Views"
             Focusable="True" AutomationProperties.Name="故事图谱自由布局画布">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Width="116" Height="34"
                    Command="{Binding DataContext.ShowProjectHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="返回故事列表" AutomationProperties.Name="图谱返回故事列表" />
            <StackPanel Orientation="Horizontal">
                <TextBox Width="170" Margin="0,0,8,0" Padding="8,5" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="搜索故事图谱" />
                <ComboBox Width="96" Margin="0,0,8,0" Padding="6,4" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}"
                          AutomationProperties.Name="筛选故事图谱" />
                <Button Margin="0,0,8,0" Padding="10,5" Command="{Binding AutoLayoutCommand}" Content="自动布局" AutomationProperties.Name="故事图谱自动布局" />
                <Button Margin="0,0,4,0" Padding="8,4" Click="Zoom100_OnClick" Content="100%" AutomationProperties.Name="故事图谱缩放到百分之百" />
                <Button Margin="0,0,4,0" Padding="8,4" Click="FitAll_OnClick" Content="适应" AutomationProperties.Name="适应全部故事节点" />
                <Button Margin="0,0,4,0" Padding="8,4" Click="ResetView_OnClick" Content="重置" AutomationProperties.Name="重置故事图谱视图" />
                <Button Width="34" Click="ZoomOut_OnClick" Content="−" AutomationProperties.Name="故事图谱缩小" />
                <TextBlock Width="58" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Zoom, StringFormat={}{0:P0}}" />
                <Button Width="34" Click="ZoomIn_OnClick" Content="+" AutomationProperties.Name="故事图谱放大" />
                <TextBlock Width="150" Margin="12,7,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                <Button Margin="4,1,0,0" Padding="6,3" Background="Transparent" BorderThickness="0" Click="Problems_OnClick"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.Name="打开故事图谱错误">
                    <TextBlock Text="{Binding ErrorCount, StringFormat=错误 {0}}" />
                </Button>
                <Button Margin="2,1,0,0" Padding="6,3" Background="Transparent" BorderThickness="0" Click="Problems_OnClick"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}" AutomationProperties.Name="打开故事图谱警告">
                    <TextBlock Text="{Binding WarningCount, StringFormat=警告 {0}}" />
                </Button>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2" Padding="10,8" BorderThickness="1" CornerRadius="5"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="跨 Story 公共逻辑桥" />
                <Grid Grid.Row="1" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox MinWidth="260" ItemsSource="{Binding LogicSources}" SelectedItem="{Binding SelectedLogicSource}"
                              DisplayMemberPath="Label" AutomationProperties.Name="选择公共逻辑输出" />
                    <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Text="→" />
                    <ComboBox Grid.Column="2" MinWidth="260" ItemsSource="{Binding LogicTargets}" SelectedItem="{Binding SelectedLogicTarget}"
                              DisplayMemberPath="Label" AutomationProperties.Name="选择公共逻辑输入" />
                    <Button Grid.Column="3" Margin="10,0,0,0" Padding="14,5" Command="{Binding AddLogicConnectionCommand}"
                            Content="连接" AutomationProperties.Name="连接跨故事公共逻辑" />
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,7,0,0">
                    <ItemsControl ItemsSource="{Binding LogicConnections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,4" Padding="8,3" CornerRadius="3"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                                        <Button Margin="8,0,0,0" Padding="5,1" Command="{Binding RemoveCommand}" Content="移除" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding LogicEditorError}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasLogicEditorError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <local:AccessibleBorder x:Name="CanvasViewport" ClipToBounds="True" Background="#14171B" Focusable="True"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5"
                    AutomationProperties.Name="故事图谱自由布局画布" AutomationProperties.AutomationId="ProjectGraphCanvasViewport"
                    PreviewMouseLeftButtonDown="GraphCanvas_OnPreviewMouseLeftButtonDown"
                    PreviewMouseDown="GraphCanvas_OnPreviewMouseDown"
                    PreviewMouseRightButtonDown="GraphCanvas_OnPreviewMouseRightButtonDown"
                    PreviewMouseMove="GraphCanvas_OnPreviewMouseMove"
                    PreviewMouseUp="GraphCanvas_OnPreviewMouseUp"
                    MouseWheel="GraphCanvas_OnMouseWheel">
                <Canvas x:Name="GraphCanvas" Background="Transparent" Focusable="True"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </local:AccessibleBorder>
        </Grid>
    </Grid>
</UserControl>
