<Window x:Class="DarkGreyRPG.Studio.Views.CanonicalActorCreationChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建角色" Width="500" Height="350" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="创建角色"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="先选择角色身份类型"/>
        <StackPanel Grid.Row="3">
            <Border Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5">
                <RadioButton GroupName="Kind" IsChecked="{Binding IsIndividual}"><StackPanel Margin="8,0,0,0"><TextBlock FontSize="16" FontWeight="SemiBold" Text="个体"/><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="使用 NPC ID 标识一个角色。"/></StackPanel></RadioButton>
            </Border>
            <Border Margin="0,12,0,0" Padding="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5">
                <RadioButton GroupName="Kind" IsChecked="{Binding IsCollective}"><StackPanel Margin="8,0,0,0"><TextBlock FontSize="16" FontWeight="SemiBold" Text="集体"/><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="使用 Group ID 标识一组角色。"/></StackPanel></RadioButton>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="88" Height="32" Margin="0,0,8,0" IsCancel="True" Content="取消"/><Button Width="88" Height="32" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="ContinueButton_OnClick" Content="继续"/></StackPanel>
    </Grid>
</Window>
