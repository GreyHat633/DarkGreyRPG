<Window x:Class="DarkGreyRPG.Studio.Views.CanonicalItemPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="640" Height="540" MinWidth="540" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Title}"/><TextBlock Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Explanation}"/>
        <TextBox Grid.Row="3" Padding="9,6" AutomationProperties.Name="{Binding SearchAutomationName}" ToolTip="按 ID、显示名称或标签搜索" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <Grid Grid.Row="5"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding EmptyText}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ListBox ItemsSource="{Binding FilteredResources}" SelectedItem="{Binding SelectedResource, Mode=TwoWay}" BorderThickness="0" HorizontalContentAlignment="Stretch" MouseDoubleClick="ResourceList_OnMouseDoubleClick"><ListBox.ItemTemplate><DataTemplate><Border Margin="0,0,0,7" Padding="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"><StackPanel><DockPanel><TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding DisplayName}"/><TextBlock DockPanel.Dock="Right" Margin="12,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Type}"/></DockPanel><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Id}"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Tags}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="88" Height="32" Margin="0,0,8,0" IsCancel="True" Content="取消"/><Button Width="88" Height="32" IsDefault="True" IsEnabled="{Binding CanConfirm}" Style="{DynamicResource AccentButtonStyle}" Click="ConfirmButton_OnClick" Content="引用"/></StackPanel>
    </Grid>
</Window>
