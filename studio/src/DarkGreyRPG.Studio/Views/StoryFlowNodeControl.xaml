<UserControl x:Class="DarkGreyRPG.Studio.Views.StoryFlowNodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DarkGreyRPG.Studio.Views"
             x:Name="Root" Focusable="True">
    <Border x:Name="NodeBorder" MinHeight="116" Background="#25292F" CornerRadius="6" Cursor="SizeAll">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#525862" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="White" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Padding="10,7" Background="{Binding Accent}" CornerRadius="5,5,0,0">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" Text="{Binding TypeLabel}" TextTrimming="CharacterEllipsis" />
            </Border>

            <Grid Grid.Row="1" Margin="0,6,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <local:FlowPortControl x:Name="InputPort" Grid.Column="0" HorizontalAlignment="Left"
                                       NodeId="{Binding Id}" PortName="input" IsInput="True" Click="InputPort_OnClick"
                                       PreviewMouseLeftButtonDown="InputPort_OnPreviewMouseLeftButtonDown">
                    <local:FlowPortControl.Style>
                        <Style TargetType="local:FlowPortControl">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AllowsInput}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:FlowPortControl.Style>
                </local:FlowPortControl>
                <ItemsControl x:Name="IncomingHandleItems" Grid.Column="0" Margin="-34,22,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              ItemsSource="{Binding IncomingConnections, ElementName=Root}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMultipleIncomingConnections, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:FlowPortControl Margin="0,1,0,1" HorizontalAlignment="Left"
                                                   NodeId="{Binding To}" PortName="{Binding From}" IsInput="True" Tag="{Binding}"
                                                   PreviewMouseLeftButtonDown="IncomingHandle_OnPreviewMouseLeftButtonDown" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="1" Margin="7,0" VerticalAlignment="Center" Foreground="#C8CDD5" FontSize="11" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                <ItemsControl x:Name="OutputItems" Grid.Column="2" ItemsSource="{Binding Outputs}" HorizontalAlignment="Right">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:FlowPortControl Margin="0,1,0,1" HorizontalAlignment="Right"
                                                   NodeId="{Binding DataContext.Id, RelativeSource={RelativeSource AncestorType=local:StoryFlowNodeControl}}"
                                                   PortName="{Binding}" Click="OutputPort_OnClick"
                                                   PreviewMouseLeftButtonDown="OutputPort_OnPreviewMouseLeftButtonDown" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Expander Grid.Row="2" Margin="8,3,8,8"
                      IsExpanded="{Binding IsAdvancedExpanded, ElementName=Root, Mode=TwoWay}"
                      Expanded="AdvancedToggle_OnChanged" Collapsed="AdvancedToggle_OnChanged"
                      AutomationProperties.Name="{Binding ParameterAutomationName}">
                <Expander.Header>
                    <TextBlock Foreground="#D7DCE4" FontSize="11" Text="{Binding ParameterHeader}" TextTrimming="CharacterEllipsis" />
                </Expander.Header>
                <Border Margin="0,5,0,0" Padding="8" Background="#1D2025" CornerRadius="4">
                    <StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResourceKey}" Value="actor_id"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding ResourceKey}" Value="dialogue_id"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding ResourceKey}" Value="quest_id"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding ResourceKey}" Value="target_story_id"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Margin="0,0,0,3" Foreground="#C8CDD5" FontSize="11" Text="{Binding ResourceLabel, ElementName=Root}" />
                            <ComboBox x:Name="ResourceSelector" MinWidth="145" Padding="5,2"
                                      ItemsSource="{Binding ResourceCandidatesView, ElementName=Root}"
                                      DisplayMemberPath="Id" SelectedValuePath="Id"
                                      SelectedValue="{Binding ResourceValue, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="ResourceSelector_OnSelectionChanged"
                                      AutomationProperties.Name="节点内资源选择器">
                                <ComboBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate><DataTemplate><TextBlock Margin="4,5,4,2" FontWeight="SemiBold" Text="{Binding Name}" /></DataTemplate></GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ComboBox.GroupStyle>
                            </ComboBox>
                            <Button Margin="0,5,0,0" Padding="6,3" HorizontalAlignment="Left" Click="AddReference_OnClick"
                                    Content="添加为引用" AutomationProperties.Name="将节点资源添加为 Story 引用">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding CanAddSelectedReference, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding CorePropertyEditors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Foreground="#C8CDD5" FontSize="11"
                                                   Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        <TextBox Grid.Column="1" MinWidth="90" Padding="5,2"
                                                 Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                 AutomationProperties.Name="{Binding Key, StringFormat=Flow 核心参数 {0}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Margin="0,6,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding CanonicalType}" Value="DialogueExitBranch"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Margin="0,0,0,3" Foreground="#C8CDD5" FontSize="11" Text="命名出口" />
                            <TextBox Padding="5,2" Text="{Binding ExitNames, Mode=OneWay}"
                                     LostFocus="ExitNames_OnLostFocus"
                                     AutomationProperties.Name="节点内 Dialogue Exit 输出" />
                        </StackPanel>
                        <StackPanel Margin="0,6,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding CanonicalType}" Value="Sequence"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Margin="0,0,0,3" Foreground="#C8CDD5" FontSize="11" Text="顺序步骤" />
                            <StackPanel Orientation="Horizontal">
                                <Button Padding="7,3" Margin="0,0,5,0" Click="AddSequenceStep_OnClick"
                                        Content="添加步骤" AutomationProperties.Name="添加 Sequence 步骤" />
                                <Button Padding="7,3" Click="RemoveSequenceStep_OnClick"
                                        Content="删除最后一步" AutomationProperties.Name="删除 Sequence 最后一步" />
                            </StackPanel>
                        </StackPanel>
                        <Expander x:Name="AdvancedPropertiesExpander" Margin="0,7,0,0" Header="高级 / 兼容参数"
                                  AutomationProperties.Name="Flow 高级与兼容参数">
                            <StackPanel Margin="0,5,0,0">
                                <ItemsControl ItemsSource="{Binding AdvancedPropertyEditors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Foreground="#C8CDD5" FontSize="11"
                                                           Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                <TextBox Grid.Column="1" MinWidth="90" Padding="5,2"
                                                         Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="{Binding Key, StringFormat=Flow 高级参数 {0}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,3,0,3" Foreground="#C8CDD5" FontSize="11" Text="节点 ID" />
                                <TextBox Padding="5,2" Text="{Binding Id, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Flow 节点高级 ID" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </Expander>
        </Grid>
    </Border>
</UserControl>
