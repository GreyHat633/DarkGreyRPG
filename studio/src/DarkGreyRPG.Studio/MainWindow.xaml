<Window x:Class="DarkGreyRPG.Studio.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DarkGreyRPG.Studio.Views"
        xmlns:graphViews="clr-namespace:DarkGreyRPG.Studio.Views.Graph"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="Assets/DarkGreyRPGStudio.ico"
        Width="1180" Height="760" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/DirectoryTreeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="ReferenceFolderExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle" HorizontalContentAlignment="Stretch"
                                          FocusVisualStyle="{x:Null}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Padding="3,4" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Width="6" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0,0 L 6,5 L 0,10 Z" Fill="{TemplateBinding Foreground}"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>




        <Geometry x:Key="ReferenceIconGeometry">M3,6 C3,3.8 4.8,2 7,2 H9 V4 H7 C5.9,4 5,4.9 5,6 C5,7.1 5.9,8 7,8 H9 V10 H7 C4.8,10 3,8.2 3,6 Z M9,6 C9,4.9 9.9,4 11,4 H13 C15.2,4 17,5.8 17,8 C17,10.2 15.2,12 13,12 H11 V10 H13 C14.1,10 15,9.1 15,8 C15,6.9 14.1,6 13,6 H11 V8 H9 V6 Z M7,5 H13 V7 H7 V5 Z</Geometry>
        <Geometry x:Key="MissingIconGeometry">M10,1 L19,18 H1 Z M10,6 V12 M10,15 V16</Geometry>


            </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static ApplicationCommands.New}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCurrentResourceCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAllCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCurrentCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCurrentCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCurrentResourceCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="NewCommand_OnExecuted" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="FindCommand_OnExecuted" />
        <CommandBinding Command="ApplicationCommands.Close" Executed="CloseCommand_OnExecuted" />
        <CommandBinding Command="ApplicationCommands.Help" Executed="HelpCommand_OnExecuted" />
    </Window.CommandBindings>
    <Grid>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="WorkspaceRow" Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="BottomPanelRow" Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Padding="6,2">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建项目…" Command="{x:Static ApplicationCommands.New}" InputGestureText="Ctrl+N" />
                <MenuItem Header="打开项目…" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="最近项目" ItemsSource="{Binding RecentProjects}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                            <Setter Property="ToolTip" Value="{Binding ProjectFile}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName, StringFormat=打开最近项目 {0}}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="保存" Command="{Binding SaveCurrentResourceCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="保存全部" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="项目文件夹" Command="{Binding OpenProjectDirectoryCommand}" />


                <Separator />
                <MenuItem Header="退出" Command="{x:Static ApplicationCommands.Close}" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="撤销" Command="{Binding UndoCurrentCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="重做" Command="{Binding RedoCurrentCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="{Binding SelectedStoryResourceActionText}" Command="{Binding DeleteCurrentResourceCommand}" InputGestureText="Delete" />
                <MenuItem Header="查找" Command="{x:Static ApplicationCommands.Find}" InputGestureText="Ctrl+F" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="跟随系统" Command="{Binding ThemeSettings.UseSystemThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <MenuItem Header="浅色" Command="{Binding ThemeSettings.UseLightThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <MenuItem Header="深色" Command="{Binding ThemeSettings.UseDarkThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Separator />
                <MenuItem Header="资源浏览器" IsCheckable="True" IsChecked="{Binding IsResourceBrowserVisible, Mode=OneWay}" Command="{Binding ToggleResourceBrowserCommand}" />
                <MenuItem Header="底部面板" IsCheckable="True" IsChecked="{Binding BottomPanel.IsExpanded, Mode=OneWay}" Command="{Binding ToggleBottomPanelCommand}" />
            </MenuItem>
            <MenuItem Header="项目(_P)">
                <MenuItem Header="新建故事…" Command="{Binding CreateStoryCommand}" />
                <MenuItem Header="引用故事包…" Command="{Binding ReferencePackageCommand}" AutomationProperties.AutomationId="ReferencePackage" />
                <MenuItem Header="迁移故事内容…" Command="{Binding CopyStoryContentCommand}" AutomationProperties.AutomationId="CopyStoryContent" />
                <MenuItem Header="导入故事包…" Command="{Binding ImportPackageCommand}" AutomationProperties.AutomationId="ImportPackage" />
                <MenuItem Header="导出故事包…" Command="{Binding ExportSelectedStoryPackageCommand}"
                          AutomationProperties.Name="导出故事包" AutomationProperties.AutomationId="ExportSelectedStoryPackage" />
                <MenuItem Header="准备 Runtime 重载" Command="{Binding PrepareRuntimeReloadCommand}" />
                <MenuItem Header="验证项目" Command="{Binding ValidateProjectCommand}" />
            </MenuItem>
            <MenuItem Header="帮助(_H)"><MenuItem Header="关于 DarkGrey RPG Studio" Command="{x:Static ApplicationCommands.Help}" /></MenuItem>
        </Menu>

        <Border Grid.Row="4" Padding="12,7"
                Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding ThemeSettings.PersistenceError, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ThemeSettings.HasPersistenceError, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <GridSplitter x:Name="BottomPanelSplitter" Grid.Row="2" Height="5"
               Cursor="SizeNS" DragCompleted="BottomPanelSplitter_OnDragCompleted"
               Background="{DynamicResource CardStrokeColorDefaultBrush}"
               HorizontalAlignment="Stretch" ResizeDirection="Rows">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BottomPanel.IsExpanded}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <Border Grid.Row="3" Height="{Binding BottomPanel.DockHeight}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <ListBox ItemsSource="{Binding BottomPanel.Tabs}" SelectedItem="{Binding BottomPanel.SelectedTab}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="BottomPanelTabBar_OnPreviewMouseLeftButtonDown"
                         MouseDoubleClick="BottomPanelTabBar_OnMouseDoubleClick">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="2,4,0,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <Border Margin="7,0,0,0" Padding="5,1" CornerRadius="8" Background="{DynamicResource SystemFillColorCriticalBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Page}" Value="Problems" />
                                                            <Condition Binding="{Binding DataContext.Problems.HasErrors, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Foreground="White" FontSize="10" Text="{Binding DataContext.Problems.ErrorCount, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="1" Margin="10,0,10,10">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding BottomPanel.IsExpanded}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border Padding="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding BottomPanel.SelectedTab.Page}" Value="Output"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <ListBox ItemsSource="{Binding Output.Entries}" BorderThickness="0" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,2">
                                        <TextBlock DockPanel.Dock="Left" Width="82" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                                        <TextBlock DockPanel.Dock="Left" Width="90" Text="{Binding Kind}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger></Style.Triggers></Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="8,0,0,0" TextWrapping="Wrap" Text="{Binding Message}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Border Padding="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding BottomPanel.SelectedTab.Page}" Value="Problems"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <DockPanel>
                        <Button DockPanel.Dock="Top" Content="清空问题" Command="{Binding Problems.ClearCommand}" HorizontalAlignment="Right" Margin="0,0,0,8" AutomationProperties.AutomationId="ClearProblemsButton" />
                        <ListView x:Name="ProblemList" ItemsSource="{Binding Problems.Problems}" BorderThickness="0" MouseDoubleClick="ProblemList_OnMouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="90" Header="严重性" DisplayMemberBinding="{Binding Severity}" />
                                    <GridViewColumn Width="180" Header="资源" DisplayMemberBinding="{Binding Source}" />
                                    <GridViewColumn Width="520" Header="问题" DisplayMemberBinding="{Binding DisplayMessage}" />
                                    <GridViewColumn Width="130" Header="字段" DisplayMemberBinding="{Binding Field}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        </DockPanel>
                    </Border>

                    <Border Padding="18" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding BottomPanel.SelectedTab.Page}" Value="Debugger"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="调试器将在后续阶段显示正在运行的任务和故事状态。" />
                    </Border>

                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ResourceBrowserColumn" Width="260" MinWidth="0" MaxWidth="400" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ResourceBrowser" Grid.Column="0" Padding="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <DockPanel>
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>

                                            <Condition Binding="{Binding IsCanonicalStoryWorkspaceVisible}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                            <Button DockPanel.Dock="Right" Width="32" Height="32" Padding="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Command="{Binding CreateStoryCommand}"
                                    AutomationProperties.Name="新建故事" ToolTip="新建故事">
                                <Viewbox Width="14" Height="14">
                                    <Path Width="12" Height="12" Data="M 1,6 L 11,6 M 6,1 L 6,11"
                                          Fill="Transparent" Stretch="None"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                            </Button>
                            <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="项目首页" />
                        </DockPanel>
                        <views:AnimatedPackageExpander DockPanel.Dock="Bottom" Header="引用故事包" Margin="0,12,0,0">
                            <views:AnimatedPackageExpander.Template>
                                <ControlTemplate TargetType="{x:Type views:AnimatedPackageExpander}">
                                    <StackPanel>
                                        <ToggleButton Padding="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="引用故事包" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                            <DockPanel><TextBlock DockPanel.Dock="Right"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="⌄"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="Text" Value="⌃"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{TemplateBinding Header}" /></DockPanel>
                                        </ToggleButton>
                                        <graphViews:AnimatedLinePageBody x:Name="PART_Reveal" IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ContentPresenter x:Name="PART_Content" Content="{TemplateBinding Content}" VerticalAlignment="Top" />
                                        </graphViews:AnimatedLinePageBody>
                                    </StackPanel>
                                </ControlTemplate>
                            </views:AnimatedPackageExpander.Template>
                            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ReferencedPackages}" AutomationProperties.Name="引用故事包区域">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Command="{Binding SelectCommand}" HorizontalContentAlignment="Left" Margin="0,4" Padding="10" Content="{Binding Label}">
                                            <Button.ContextMenu><ContextMenu><MenuItem Header="移除引用故事包" Command="{Binding RemoveCommand}" /></ContextMenu></Button.ContextMenu>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </views:AnimatedPackageExpander>
                        <TextBox x:Name="StorySearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,5"
                                 AutomationProperties.Name="搜索故事" ToolTip="按 ID、显示名称或标签搜索"
                                 Text="{Binding ProjectHome.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasProject}" Value="True" /><Condition Binding="{Binding ProjectHome.IsEmptyProject}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding ProjectHome.EmptyStateTitle}" />
                            <TextBlock Margin="0,5,0,0" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ProjectHome.EmptyStateDescription}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasProject}" Value="True" /><Condition Binding="{Binding ProjectHome.IsSearchNoResults}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding ProjectHome.SearchNoResultsTitle}" />
                            <Button Margin="0,8,0,0" Padding="8,4" Command="{Binding ProjectHome.ClearSearchCommand}" Content="清空搜索" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="请先从“文件”菜单新建或打开项目。">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasProject}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <views:StoryNavigationList x:Name="StoryList" ItemsSource="{Binding ProjectHome.GroupedStories}" SelectedItem="{Binding ProjectHome.SelectedStory}"
                                 BorderThickness="0" HorizontalContentAlignment="Stretch" MouseDoubleClick="StoryList_OnMouseDoubleClick"
                                 ItemContainerStyle="{StaticResource StoryNavigationItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PreviewMouseLeftButtonDown="StoryList_OnPreviewMouseLeftButtonDown"
                                 PreviewMouseRightButtonDown="StoryList_OnPreviewMouseRightButtonDown"
                                 PreviewMouseMove="StoryNavigation_OnMouseMove" AllowDrop="True"
                                 AutomationProperties.Name="故事导航列表"
                                 Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasProject}" Value="True" /><Condition Binding="{Binding ProjectHome.HasFilteredStories}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></ListBox.Style>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel x:Name="GroupSection" Margin="0,7,0,5">
                                                            <DockPanel x:Name="GroupHeader" Margin="3,0,3,2" MinHeight="36" Background="Transparent" PreviewMouseLeftButtonDown="StoryNavigation_OnDragStart" PreviewMouseLeftButtonUp="StoryNavigation_OnHeaderRelease" LostMouseCapture="StoryNavigation_OnHeaderCaptureLost" ContextMenuOpening="StoryGroupName_OnContextMenuOpening">
                                                                <DockPanel.ContextMenu><ContextMenu /></DockPanel.ContextMenu>
                                                                <TextBlock x:Name="GroupDragHandle" Text="⠿" DockPanel.Dock="Right" Width="24" TextAlignment="Center" VerticalAlignment="Center" Cursor="SizeNS" ToolTip="拖动整个故事组调整顺序" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <ToggleButton x:Name="GroupToggle" IsChecked="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="展开或收起故事组">
                                                                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                                                        <Border x:Name="HeaderSurface" Background="Transparent" Padding="5,6" CornerRadius="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="Arrow" Data="M 0 0 L 5 4 L 0 8 Z" Fill="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" /><ContentPresenter Grid.Column="1" VerticalAlignment="Center"/></Grid></Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
                                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /></Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate></ToggleButton.Template>
                                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                        <Path Width="15" Height="13" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Data="{StaticResource DirectoryFolderIconGeometry}" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1.3" />
                                                                        <TextBlock x:Name="GroupName" Grid.Column="1" Text="{Binding Name.DisplayName}" Style="{StaticResource DirectoryFolderLabelStyle}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name.DisplayName}" />
                                                                        <TextBlock Grid.Column="2" Margin="8,0,3,0" Text="{Binding Name.Members.Count, StringFormat={}{0} 个故事}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                    </Grid>
                                                                </ToggleButton>
                                                            </DockPanel>
                                                            <graphViews:AnimatedLinePageBody IsExpanded="{Binding IsChecked, ElementName=GroupToggle}">
                                                                <Border x:Name="MemberGuide" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource TextFillColorTertiaryBrush}" Margin="20,0,0,1">
                                                                    <ItemsPresenter />
                                                                </Border>
                                                            </graphViews:AnimatedLinePageBody>
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Name.IsGroup}" Value="False"><Setter TargetName="GroupHeader" Property="Visibility" Value="Collapsed" /><Setter TargetName="GroupSection" Property="Margin" Value="0" /><Setter TargetName="MemberGuide" Property="BorderThickness" Value="0" /><Setter TargetName="MemberGuide" Property="Margin" Value="0" /></DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="34"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                    <Path Width="13" Height="16" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0" Data="{StaticResource DirectoryDocumentIconGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Opacity="0.7" StrokeThickness="1.2" />
                                    <TextBlock Grid.Column="2" Text="⠿" VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="SizeNS" ToolTip="拖动调整故事或故事组的顺序" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Opacity="0.7"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource DirectoryLeafLabelStyle}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource DirectoryAuxiliaryLabelStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Text="{Binding Id, StringFormat=UID: {0}}" ToolTip="{Binding Id}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TagsText}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel></Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </views:StoryNavigationList>
                    </DockPanel>



                </Grid>
            </Border>

            <GridSplitter x:Name="ResourceBrowserSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource CardStrokeColorDefaultBrush}"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2" Margin="12" Padding="18"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasProject}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="SemiBold" Text="DarkGrey RPG Studio" />
                        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="从“文件”菜单新建或打开项目。" />
                    </StackPanel>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasProject}" Value="True" /><Condition Binding="{Binding IsCanonicalStoryWorkspaceVisible}" Value="False" /><Condition Binding="{Binding ProjectHome.IsHomeVisible}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style>
                        </Grid.Style>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Width="116" Height="34" Command="{Binding OpenSelectedStoryCommand}"
                                    Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="进入选中故事" Content="进入故事" />
                            <StackPanel>
                                <TextBlock FontSize="26" FontWeight="SemiBold" Text="项目故事图谱" />
                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="左侧选择故事，中央整理故事布局，右侧查看当前故事详情。" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                            <views:ProjectGraphView DataContext="{Binding ProjectHome.Graph}" />
                            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                            <Border Grid.Column="2" Padding="16" Background="{DynamicResource LayerFillColorAltBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                <Grid><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="HomeStoryInspectorContent" DataContext="{Binding ProjectHome.SelectedStory.Overview}">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.SelectedReferencedPackage, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding DataContext.ProjectHome.SelectedStory, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="故事详情" />
                                    <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding DisplayName}"
                                               TextWrapping="Wrap" AutomationProperties.Name="选中故事完整概览" />
                                    <TextBlock Margin="0,4,0,18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Id}" TextWrapping="Wrap" />
                                    <graphViews:PublicOutputsEditor DataContext="{Binding DataContext.ProjectHome.Graph.SelectedOutputs, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <ItemsControl ItemsSource="{Binding DataContext.HomeResourceFolders, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Expander Header="{Binding DisplayName}" IsExpanded="False" IsEnabled="{Binding HasResources}"
                                                      Style="{StaticResource ReferenceFolderExpanderStyle}" Margin="0,2">
                                                <ListBox ItemsSource="{Binding Items}" Margin="10,2,0,6" BorderThickness="0"
                                                         Background="Transparent" HorizontalContentAlignment="Stretch"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="6,4"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <EventSetter Event="MouseDoubleClick" Handler="HomeResource_OnMouseDoubleClick"/>
                                                    </Style></ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate><DataTemplate>
                                                        <TextBlock ToolTip="{Binding ToolTip}" TextAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                            <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding IdentityText, Mode=OneWay}" FontSize="11"/>
                                                        </TextBlock>
                                                    </DataTemplate></ListBox.ItemTemplate>
                                                </ListBox>
                                            </Expander>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel></ScrollViewer>
                                <ScrollViewer Background="{DynamicResource LayerFillColorAltBrush}" VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedReferencedPackage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                                    <StackPanel DataContext="{Binding SelectedReferencedPackage}">
                                        <TextBlock Text="引用故事包" FontSize="12" />
                                        <TextBlock Text="{Binding Label}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                        <Button Content="故事流程图" Command="{Binding StoryGraphCommand}" Margin="0,0,0,12" Padding="10,6" />
                                        <TextBlock Text="资源（只读）" FontWeight="SemiBold" Margin="0,4,0,8" />
                                        <ItemsControl ItemsSource="{Binding Folders}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Expander Margin="0,2" Header="{Binding DisplayName}" IsExpanded="False"
                                                          IsEnabled="{Binding HasResources}" Style="{StaticResource ReferenceFolderExpanderStyle}"
                                                          AutomationProperties.Name="{Binding DisplayName}">
                                                    <ItemsControl Margin="10,2,0,6" ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate><DataTemplate>
                                                            <Button Margin="0,1" Padding="6,4" HorizontalContentAlignment="Stretch"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                                                    MouseDoubleClick="ReferencedResource_OnMouseDoubleClick">
                                                                <TextBlock TextAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                                    <Run Text="{Binding Resource.DisplayName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Resource.TypeLabel, Mode=OneWay}" FontSize="11"/>
                                                                </TextBlock>
                                                            </Button>
                                                        </DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </ScrollViewer></Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid>
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /></Style></Grid.Style>
                    </Grid>

                    <Grid>
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsCanonicalStoryWorkspaceVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <graphViews:CanonicalStoryWorkspaceView Workspace="{Binding CanonicalStoryWorkspace}" />
                    </Grid>


                </Grid>
            </Border>

        </Grid>
    </Grid>
        <Border Margin="0,24,24,0" Padding="14,10" MaxWidth="480"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Toast.IsVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        <DataTrigger Binding="{Binding Toast.Kind}" Value="Warning"><Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Toast.Kind}" Value="Error"><Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="28" Height="28" Margin="12,0,0,0" Click="DismissToast_OnClick" Content="×" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Toast.Message}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
