<Window x:Class="DarkGreyRPG.Studio.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DarkGreyRPG.Studio.Views"
        mc:Ignorable="d"
        Title="DarkGrey RPG Studio 2.1.2"
        Icon="Assets/DarkGreyRPGStudio.ico"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <DataTemplate x:Key="ActorEditorTemplate">
            <Grid Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="12" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="12" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Right" Margin="12,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SaveStateText}" />
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                </DockPanel>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Actor ID" /><TextBox Grid.Column="1" Padding="8,5" IsReadOnly="True" Text="{Binding Id, Mode=OneWay}" /></Grid>
                <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="显示名称" /><TextBox Grid.Column="1" Padding="8,5" AutomationProperties.Name="Actor 显示名称" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Margin="0,7,0,0" VerticalAlignment="Top" Text="备注" /><TextBox Grid.Column="1" MinHeight="100" Padding="8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                <Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="标签" /><TextBox Grid.Column="1" Padding="8,5" ToolTip="使用逗号分隔多个标签" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                <DockPanel Grid.Row="10"><Button DockPanel.Dock="Right" Width="96" Height="32" Command="{Binding DataContext.SaveActorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="保存 Actor" Content="保存" /><TextBlock Margin="0,7,12,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Text="{Binding ValidationText}" /></DockPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DialogueEditorTemplate"><views:DialogueEditorView /></DataTemplate>
        <DataTemplate x:Key="QuestEditorTemplate"><views:QuestEditorView /></DataTemplate>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static ApplicationCommands.New}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCurrentResourceCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAllCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCurrentCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCurrentCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateActorCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCurrentResourceCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="NewCommand_OnExecuted" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="FindCommand_OnExecuted" />
        <CommandBinding Command="ApplicationCommands.Close" Executed="CloseCommand_OnExecuted" />
        <CommandBinding Command="ApplicationCommands.Help" Executed="HelpCommand_OnExecuted" />
    </Window.CommandBindings>
    <Grid>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="WorkspaceRow" Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="BottomPanelRow" Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Padding="6,2">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建项目…" Command="{x:Static ApplicationCommands.New}" InputGestureText="Ctrl+N" />
                <MenuItem Header="打开项目…" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="最近项目" ItemsSource="{Binding RecentProjects}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                            <Setter Property="ToolTip" Value="{Binding ProjectFile}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName, StringFormat=打开最近项目 {0}}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="保存" Command="{Binding SaveCurrentResourceCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="保存全部" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="项目文件夹" Command="{Binding OpenProjectDirectoryCommand}" />
                <Separator />
                <MenuItem Header="退出" Command="{x:Static ApplicationCommands.Close}" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="撤销" Command="{Binding UndoCurrentCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="重做" Command="{Binding RedoCurrentCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="复制资源" Command="{Binding DuplicateActorCommand}" InputGestureText="Ctrl+D" />
                <MenuItem Header="删除资源" Command="{Binding DeleteCurrentResourceCommand}" InputGestureText="Delete" />
                <MenuItem Header="查找" Command="{x:Static ApplicationCommands.Find}" InputGestureText="Ctrl+F" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="跟随系统" Command="{Binding ThemeSettings.UseSystemThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <MenuItem Header="浅色" Command="{Binding ThemeSettings.UseLightThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <MenuItem Header="深色" Command="{Binding ThemeSettings.UseDarkThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Separator />
                <MenuItem Header="资源浏览器" IsCheckable="True" IsChecked="{Binding IsResourceBrowserVisible, Mode=OneWay}" Command="{Binding ToggleResourceBrowserCommand}" />
                <MenuItem Header="底部面板" IsCheckable="True" IsChecked="{Binding BottomPanel.IsExpanded, Mode=OneWay}" Command="{Binding ToggleBottomPanelCommand}" />
            </MenuItem>
            <MenuItem Header="项目(_P)">
                <MenuItem Header="新建剧情…" Command="{Binding CreateStoryCommand}" />
                <Separator />
                <MenuItem Header="准备 Runtime 重载" Command="{Binding PrepareRuntimeReloadCommand}" />
                <MenuItem Header="验证项目" Command="{Binding ValidateProjectCommand}" />
                <MenuItem Header="项目设置" Command="{Binding ShowProjectSettingsCommand}" />
            </MenuItem>
            <MenuItem Header="帮助(_H)"><MenuItem Header="关于 DarkGrey RPG Studio" Command="{x:Static ApplicationCommands.Help}" /></MenuItem>
        </Menu>

        <Border Grid.Row="1" Padding="16,10"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                ToolTip="{Binding ProjectDirectory}">
            <StackPanel>
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="DarkGrey RPG Studio" />
                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ProjectDisplayName}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Padding="12,7"
                Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding ThemeSettings.PersistenceError, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ThemeSettings.HasPersistenceError, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <GridSplitter x:Name="BottomPanelSplitter" Grid.Row="3" Height="5"
               Cursor="SizeNS" DragCompleted="BottomPanelSplitter_OnDragCompleted"
               Background="{DynamicResource CardStrokeColorDefaultBrush}"
               HorizontalAlignment="Stretch" ResizeDirection="Rows">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BottomPanel.IsExpanded}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <Border Grid.Row="4" Height="{Binding BottomPanel.DockHeight}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <ListBox ItemsSource="{Binding BottomPanel.Tabs}" SelectedItem="{Binding BottomPanel.SelectedTab}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="BottomPanelTabBar_OnPreviewMouseLeftButtonDown"
                         MouseDoubleClick="BottomPanelTabBar_OnMouseDoubleClick">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="2,4,0,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <Border Margin="7,0,0,0" Padding="5,1" CornerRadius="8" Background="{DynamicResource SystemFillColorCriticalBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Page}" Value="Problems" />
                                                            <Condition Binding="{Binding DataContext.Problems.HasErrors, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Foreground="White" FontSize="10" Text="{Binding DataContext.Problems.ErrorCount, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="1" Margin="10,0,10,10">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding BottomPanel.IsExpanded}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border Padding="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding BottomPanel.SelectedTab.Page}" Value="Output"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <ListBox ItemsSource="{Binding Output.Entries}" BorderThickness="0" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,2">
                                        <TextBlock DockPanel.Dock="Left" Width="82" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                                        <TextBlock DockPanel.Dock="Left" Width="90" Text="{Binding Kind}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger></Style.Triggers></Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="8,0,0,0" TextWrapping="Wrap" Text="{Binding Message}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Border Padding="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding BottomPanel.SelectedTab.Page}" Value="Problems"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <ListView x:Name="ProblemList" ItemsSource="{Binding Problems.Problems}" BorderThickness="0" MouseDoubleClick="ProblemList_OnMouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="90" Header="严重性" DisplayMemberBinding="{Binding Severity}" />
                                    <GridViewColumn Width="180" Header="资源" DisplayMemberBinding="{Binding Source}" />
                                    <GridViewColumn Width="520" Header="问题" DisplayMemberBinding="{Binding Message}" />
                                    <GridViewColumn Width="130" Header="字段" DisplayMemberBinding="{Binding Field}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <Border Padding="18" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding BottomPanel.SelectedTab.Page}" Value="Debugger"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="调试器将在后续阶段显示正在运行的任务和剧情状态。" />
                    </Border>

                    <Border Padding="18" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding BottomPanel.SelectedTab.Page}" Value="Minecraft"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Minecraft 未连接" />
                            <TextBlock Margin="0,8,0,0" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="当前版本通过项目文件和 /dgrpg reload 与 Runtime 配合。&#x0a;Live Bridge 将在后续阶段加入。" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition x:Name="ResourceBrowserColumn" Width="260" MinWidth="0" MaxWidth="400" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource LayerFillColorAltBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <ListBox Margin="5,8" ItemsSource="{Binding Navigation.Items}" SelectedItem="{Binding Navigation.SelectedItem}"
                         BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,5" HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="6" Background="Transparent">
                                    <Path Width="20" Height="20" Stretch="Uniform" Data="{Binding IconGeometry}">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"><Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Border>
                                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="11" Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border x:Name="ResourceBrowser" Grid.Column="1" Padding="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <DockPanel>
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Navigation.SelectedItem.Page}" Value="Story" />
                                            <Condition Binding="{Binding StoryWorkspace.HasStory}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                            <Button DockPanel.Dock="Right" Width="32" Height="32" Padding="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Command="{Binding CreateStoryCommand}"
                                    AutomationProperties.Name="新建剧情" ToolTip="新建剧情">
                                <Viewbox Width="14" Height="14">
                                    <Path Width="12" Height="12" Data="M 1,6 L 11,6 M 6,1 L 6,11"
                                          Fill="Transparent" Stretch="None"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                            </Button>
                            <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="项目首页" />
                        </DockPanel>
                        <UniformGrid DockPanel.Dock="Top" Margin="0,0,0,12" Columns="2">
                            <Button Margin="0,0,4,0" Padding="6" Command="{Binding ShowProjectHomeCommand}" Content="剧情列表" />
                            <Button Margin="4,0,0,0" Padding="6" Command="{Binding ShowProjectGraphCommand}" Content="剧情图谱" />
                        </UniformGrid>
                        <TextBox x:Name="StorySearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,5"
                                 AutomationProperties.Name="搜索剧情" ToolTip="按 ID、显示名称或标签搜索"
                                 Text="{Binding ProjectHome.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="请先从“文件”菜单新建或打开项目。">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasProject}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <ListBox x:Name="StoryList" ItemsSource="{Binding ProjectHome.FilteredStories}" SelectedItem="{Binding ProjectHome.SelectedStory}"
                                 BorderThickness="0" HorizontalContentAlignment="Stretch" MouseDoubleClick="StoryList_OnMouseDoubleClick"
                                 PreviewMouseRightButtonDown="StoryList_OnPreviewMouseRightButtonDown"
                                 AutomationProperties.Name="剧情导航列表"
                                 Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasProject}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5,7">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Id}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TagsText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <DockPanel>
                        <DockPanel.Style>
                            <Style TargetType="DockPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding StoryWorkspace.HasStory}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                        </DockPanel.Style>
                        <Button DockPanel.Dock="Top" Margin="0,0,0,12" Padding="8,6" HorizontalContentAlignment="Left" Command="{Binding ShowProjectHomeCommand}" Content="← 返回项目首页" />
                        <TextBlock DockPanel.Dock="Top" FontSize="17" FontWeight="SemiBold" Text="{Binding StoryWorkspace.StoryDisplayName}" TextWrapping="Wrap" />
                        <TextBlock DockPanel.Dock="Top" Margin="0,3,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StoryWorkspace.StoryId}" />
                        <ListBox ItemsSource="{Binding StoryWorkspace.Routes}" SelectedItem="{Binding StoryWorkspace.SelectedRoute, Mode=TwoWay}"
                                 BorderThickness="0" HorizontalContentAlignment="Stretch" Background="Transparent"
                                 AutomationProperties.Name="剧情页面列表">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9" /><Setter Property="Margin" Value="0,2" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" /></Trigger></Style.Triggers></Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><TextBlock FontWeight="SemiBold" Text="{Binding Title}" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Navigation.SelectedItem.Page}" Value="Settings"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="设置" />
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="应用与项目设置" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter x:Name="ResourceBrowserSplitter" Grid.Column="2" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource CardStrokeColorDefaultBrush}"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="3" Margin="12" Padding="18"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Navigation.SelectedItem.Page}" Value="Settings"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
                </Border.Style>
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasProject}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="SemiBold" Text="DarkGrey RPG Studio" />
                        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="从“文件”菜单新建或打开项目。" />
                    </StackPanel>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasProject}" Value="True" /><Condition Binding="{Binding StoryWorkspace.HasStory}" Value="False" /><Condition Binding="{Binding ProjectHome.IsHomeVisible}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style>
                        </Grid.Style>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Width="116" Height="34" Command="{Binding OpenSelectedStoryCommand}"
                                    Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="进入选中剧情" Content="进入剧情" />
                            <StackPanel>
                                <TextBlock FontSize="26" FontWeight="SemiBold" Text="剧情概览" />
                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="剧情选择与搜索统一在左侧完成；这里显示当前选中剧情的信息。" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,18,0,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding ProjectHome.SelectedStory}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock HorizontalAlignment="Center" TextAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="当前项目还没有选中的剧情。" />
                                <Button Width="128" Height="36" Margin="0,14,0,0" Command="{Binding CreateStoryCommand}"
                                        Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="从空状态新建剧情" Content="新建剧情" />
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0" VerticalAlignment="Top"
                                        DataContext="{Binding ProjectHome.SelectedStory.Overview}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><Trigger Property="DataContext" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style>
                                </StackPanel.Style>
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding DisplayName}"
                                           AutomationProperties.Name="选中剧情完整概览" />
                                <TextBlock Margin="0,4,0,18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Id}" />
                                <TextBlock FontWeight="SemiBold" Text="描述" />
                                <TextBlock Margin="0,6,0,18" TextWrapping="Wrap" Text="{Binding Description}" />
                                <TextBlock FontWeight="SemiBold" Text="资源归属" />
                                <TextBlock Margin="0,6,0,18" Text="{Binding MembershipSummary}" />
                                <TextBlock FontWeight="SemiBold" Text="Flow" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding FlowNodeCount, StringFormat={}{0} 个节点}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid>
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding StoryWorkspace.HasStory}" Value="False" /><Condition Binding="{Binding ProjectHome.IsGraphVisible}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
                        <views:ProjectGraphView DataContext="{Binding ProjectHome.Graph}" />
                    </Grid>

                    <Grid>
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding StoryWorkspace.HasStory}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel><Button DockPanel.Dock="Right" Width="112" Height="32" Command="{Binding ShowProjectHomeCommand}" Content="返回项目首页" /><StackPanel><TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding StoryWorkspace.StoryDisplayName}" /><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StoryWorkspace.StoryId}" /></StackPanel></DockPanel>
                        <TextBlock Grid.Row="1" Margin="0,12,0,12" FontSize="15" FontWeight="SemiBold" Text="{Binding StoryWorkspace.SelectedRoute.Title}" />
                        <Grid Grid.Row="2">
                            <Grid>
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding StoryWorkspace.CurrentRoute}" Value="Actors"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Width="104" Height="34" Margin="0,0,8,0" Command="{Binding NewActorCommand}"
                                            Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="创建角色" Content="+ 创建" />
                                    <Button Width="104" Height="34" Command="{Binding ReferenceActorCommand}"
                                            AutomationProperties.Name="引用角色" Content="引用" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <Grid.Resources>
                                        <DataTemplate x:Key="StoryActorMembershipTemplate">
                                            <Border Margin="0,0,0,6" Padding="10" Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                    <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Id}" />
                                                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Text="{Binding SourceLabel}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <TextBox Margin="0,0,0,8" Padding="8,5" AutomationProperties.Name="搜索剧情角色"
                                                 Text="{Binding StoryWorkspace.Actors.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                        <GroupBox Grid.Row="1" Margin="0,0,0,8" Header="本剧情" Padding="6">
                                            <ListBox ItemsSource="{Binding StoryWorkspace.Actors.FilteredOwnedMemberships}"
                                                     SelectedItem="{Binding SelectedStoryActor, Mode=TwoWay}"
                                                     ItemTemplate="{StaticResource StoryActorMembershipTemplate}"
                                                     BorderThickness="0" HorizontalContentAlignment="Stretch" />
                                        </GroupBox>
                                        <GroupBox Grid.Row="2" Header="引用" Padding="6">
                                            <ListBox ItemsSource="{Binding StoryWorkspace.Actors.FilteredReferencedMemberships}"
                                                     SelectedItem="{Binding SelectedStoryActor, Mode=TwoWay}"
                                                     ItemTemplate="{StaticResource StoryActorMembershipTemplate}"
                                                     BorderThickness="0" HorizontalContentAlignment="Stretch" />
                                        </GroupBox>
                                    </Grid>
                                    <Border Grid.Column="2" Padding="16" Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="4">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="选择本剧情中的角色开始编辑。">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentActor}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                                <ContentControl Content="{Binding CurrentActor}" ContentTemplate="{StaticResource ActorEditorTemplate}">
                                                    <ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></ContentControl.Style>
                                                </ContentControl>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button MinWidth="96" Height="32" Margin="0,0,8,0" Command="{Binding ViewActorReferencesCommand}" Content="查看引用" />
                                                <Button MinWidth="96" Height="32" Margin="0,0,8,0" Command="{Binding RemoveActorReferenceCommand}" Content="解除引用" />
                                                <Button MinWidth="96" Height="32" Command="{Binding DeleteActorCommand}" Content="删除资源" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Grid>
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding StoryWorkspace.CurrentRoute}" Value="Dialogues"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Width="104" Height="34" Margin="0,0,8,0" Command="{Binding NewStoryResourceCommand}" Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="创建 Dialogue" Content="+ 创建" />
                                    <Button Width="104" Height="34" Command="{Binding ReferenceStoryResourceCommand}" AutomationProperties.Name="引用 Dialogue" Content="引用" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBox Margin="0,0,0,8" Padding="8,5" AutomationProperties.Name="搜索 Dialogue" Text="{Binding StoryWorkspace.Dialogues.SearchText, UpdateSourceTrigger=PropertyChanged}" /><ListBox Grid.Row="1" ItemsSource="{Binding StoryWorkspace.Dialogues.FilteredItems}" SelectedItem="{Binding SelectedStoryResource, Mode=TwoWay}" BorderThickness="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="剧情 Dialogue 列表"><ListBox.ItemTemplate><DataTemplate><Border Margin="0,0,0,7" Padding="12" Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="4"><DockPanel><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Text="{Binding MembershipKind}" /><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" /><TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Id}" /></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                                    <Border Grid.Column="2" Padding="16" Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="4"><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="选择对话开始编辑。"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentDialogue}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding CurrentDialogue}" ContentTemplate="{StaticResource DialogueEditorTemplate}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></ContentControl.Style></ContentControl></Grid><StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button MinWidth="96" Height="32" Margin="0,0,8,0" Command="{Binding ViewStoryResourceReferencesCommand}" Content="查看引用" /><Button MinWidth="96" Height="32" Margin="0,0,8,0" Command="{Binding RemoveStoryResourceReferenceCommand}" Content="解除引用" /><Button MinWidth="96" Height="32" Command="{Binding DeleteStoryResourceCommand}" Content="删除资源" /></StackPanel></Grid></Border>
                                </Grid>
                            </Grid>

                            <Grid>
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding StoryWorkspace.CurrentRoute}" Value="Quests"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Width="104" Height="34" Margin="0,0,8,0" Command="{Binding NewStoryResourceCommand}" Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="创建 Quest" Content="+ 创建" />
                                    <Button Width="104" Height="34" Command="{Binding ReferenceStoryResourceCommand}" AutomationProperties.Name="引用 Quest" Content="引用" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBox Margin="0,0,0,8" Padding="8,5" AutomationProperties.Name="搜索 Quest" Text="{Binding StoryWorkspace.Quests.SearchText, UpdateSourceTrigger=PropertyChanged}" /><ListBox Grid.Row="1" ItemsSource="{Binding StoryWorkspace.Quests.FilteredItems}" SelectedItem="{Binding SelectedStoryResource, Mode=TwoWay}" BorderThickness="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="剧情 Quest 列表"><ListBox.ItemTemplate><DataTemplate><Border Margin="0,0,0,7" Padding="12" Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="4"><DockPanel><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Text="{Binding MembershipKind}" /><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" /><TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Id}" /></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                                    <Border Grid.Column="2" Padding="16" Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="4"><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="选择任务开始编辑。"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentQuest}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding CurrentQuest}" ContentTemplate="{StaticResource QuestEditorTemplate}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></ContentControl.Style></ContentControl></Grid><StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button MinWidth="96" Height="32" Margin="0,0,8,0" Command="{Binding ViewStoryResourceReferencesCommand}" Content="查看引用" /><Button MinWidth="96" Height="32" Margin="0,0,8,0" Command="{Binding RemoveStoryResourceReferenceCommand}" Content="解除引用" /><Button MinWidth="96" Height="32" Command="{Binding DeleteStoryResourceCommand}" Content="删除资源" /></StackPanel></Grid></Border>
                                </Grid>
                            </Grid>

                            <Grid>
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding StoryWorkspace.CurrentRoute}" Value="Flow"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <views:StoryFlowEditorView DataContext="{Binding CurrentFlow}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="3" Margin="12" Padding="28"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Navigation.SelectedItem.Page}" Value="Settings"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                </Border.Style>
                <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="设置" />
                    <TextBlock Margin="0,10,0,24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="外观更改立即生效并在重启后恢复。" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="应用主题" />
                        <ComboBox Grid.Column="1" Height="34" AutomationProperties.Name="应用主题"
                                  ItemsSource="{Binding ThemeSettings.ThemeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding ThemeSettings.SelectedTheme, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
        <Border Margin="0,108,24,0" Padding="14,10" MaxWidth="480"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Toast.IsVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        <DataTrigger Binding="{Binding Toast.Kind}" Value="Warning"><Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Toast.Kind}" Value="Error"><Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="28" Height="28" Margin="12,0,0,0" Click="DismissToast_OnClick" Content="×" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Toast.Message}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
