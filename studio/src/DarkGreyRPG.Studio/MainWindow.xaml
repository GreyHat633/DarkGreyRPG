<Window x:Class="DarkGreyRPG.Studio.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DarkGreyRPG.Studio.Views"
        xmlns:graphViews="clr-namespace:DarkGreyRPG.Studio.Views.Graph"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="Assets/DarkGreyRPGStudio.ico"
        Width="1180" Height="760" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ReferenceFolderExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle" HorizontalContentAlignment="Stretch"
                                          FocusVisualStyle="{x:Null}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Padding="3,4" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Width="6" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0,0 L 6,5 L 0,10 Z" Fill="{TemplateBinding Foreground}"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ActorEditorTemplate">
            <Grid Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="12" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="12" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Right" Margin="12,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SaveStateText}" />
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                </DockPanel>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="角色 ID" /><TextBox Grid.Column="1" Padding="8,5" IsReadOnly="True" Text="{Binding Id, Mode=OneWay}" /></Grid>
                <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="显示名称" /><TextBox Grid.Column="1" Padding="8,5" AutomationProperties.Name="角色显示名称" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel>
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SupportsPortraits}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="默认头像" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                            <Button Content="导入图片…" Tag="default" Click="ImportActorPortrait_OnClick"/>
                            <Button Content="移除默认头像" Margin="6,0,0,0" Click="RemoveActorDefaultPortrait_OnClick"/>
                            <TextBlock Margin="8,4,0,0" Text="{Binding DefaultPortraitStatus}"/>
                        </StackPanel>
                        <TextBlock Text="头像变体" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <ListBox Height="100" ItemsSource="{Binding PortraitVariants}" SelectedItem="{Binding SelectedPortraitVariant}" DisplayMemberPath="Name"/>
                        <TextBlock Text="变体名称" Margin="0,6,0,3"/>
                        <TextBox Text="{Binding PortraitVariantName, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Button Content="导入为新变体…" Tag="variant" Click="ImportActorPortrait_OnClick"/>
                            <Button Content="重命名选中变体" Margin="6,0,0,0" Click="RenameActorPortrait_OnClick"/>
                            <Button Content="移除选中变体" Margin="6,0,0,0" Click="RemoveActorPortrait_OnClick"/>
                        </StackPanel>
                        </StackPanel>
                        <TextBlock Text="备注" Margin="0,10,0,3"/>
                        <TextBox MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="标签" /><TextBox Grid.Column="1" Padding="8,5" ToolTip="使用逗号分隔多个标签" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" /></Grid>
                <DockPanel Grid.Row="10"><Button DockPanel.Dock="Right" Width="96" Height="32" Command="{Binding DataContext.SaveActorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="保存角色" Content="保存" /><TextBlock Margin="0,7,12,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Text="{Binding ValidationText}" /></DockPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DialogueEditorTemplate"><views:DialogueEditorView /></DataTemplate>
        <DataTemplate x:Key="QuestEditorTemplate"><views:QuestEditorView /></DataTemplate>
        <Geometry x:Key="ReferenceIconGeometry">M3,6 C3,3.8 4.8,2 7,2 H9 V4 H7 C5.9,4 5,4.9 5,6 C5,7.1 5.9,8 7,8 H9 V10 H7 C4.8,10 3,8.2 3,6 Z M9,6 C9,4.9 9.9,4 11,4 H13 C15.2,4 17,5.8 17,8 C17,10.2 15.2,12 13,12 H11 V10 H13 C14.1,10 15,9.1 15,8 C15,6.9 14.1,6 13,6 H11 V8 H9 V6 Z M7,5 H13 V7 H7 V5 Z</Geometry>
        <Geometry x:Key="MissingIconGeometry">M10,1 L19,18 H1 Z M10,6 V12 M10,15 V16</Geometry>
        <DataTemplate x:Key="StoryActorMembershipTemplate">
            <Border MinHeight="56" Margin="0,0,0,4" Padding="8,5" CornerRadius="3" ToolTip="{Binding MembershipTooltip}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}" Value="True"><Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AccentFillColorDefaultBrush}" Data="{StaticResource ReferenceIconGeometry}">
                            <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsReferenced}" Value="True" /><Condition Binding="{Binding IsResolved}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Path.Style>
                        </Path>
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource SystemFillColorCautionBrush}" StrokeThickness="1.5" Data="{StaticResource MissingIconGeometry}">
                            <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Path.Style>
                        </Path>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="StoryResourceMembershipTemplate">
            <Border MinHeight="56" Margin="0,0,0,4" Padding="8,5" CornerRadius="3" ToolTip="{Binding MembershipTooltip}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}" Value="True"><Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AccentFillColorDefaultBrush}" Data="{StaticResource ReferenceIconGeometry}">
                            <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsReferenced}" Value="True" /><Condition Binding="{Binding IsResolved}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Path.Style>
                        </Path>
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource SystemFillColorCautionBrush}" StrokeThickness="1.5" Data="{StaticResource MissingIconGeometry}">
                            <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Path.Style>
                        </Path>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding DraftBadge}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static ApplicationCommands.New}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCurrentResourceCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAllCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCurrentCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCurrentCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateActorCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCurrentResourceCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="NewCommand_OnExecuted" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="FindCommand_OnExecuted" />
        <CommandBinding Command="ApplicationCommands.Close" Executed="CloseCommand_OnExecuted" />
        <CommandBinding Command="ApplicationCommands.Help" Executed="HelpCommand_OnExecuted" />
    </Window.CommandBindings>
    <Grid>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="WorkspaceRow" Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="BottomPanelRow" Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Padding="6,2">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建项目…" Command="{x:Static ApplicationCommands.New}" InputGestureText="Ctrl+N" />
                <MenuItem Header="打开项目…" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="最近项目" ItemsSource="{Binding RecentProjects}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding DisplayName}" />
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                            <Setter Property="ToolTip" Value="{Binding ProjectFile}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName, StringFormat=打开最近项目 {0}}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="保存" Command="{Binding SaveCurrentResourceCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="保存全部" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="项目文件夹" Command="{Binding OpenProjectDirectoryCommand}" />


                <Separator />
                <MenuItem Header="退出" Command="{x:Static ApplicationCommands.Close}" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="撤销" Command="{Binding UndoCurrentCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="重做" Command="{Binding RedoCurrentCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="复制资源" Command="{Binding DuplicateActorCommand}" InputGestureText="Ctrl+D" />
                <MenuItem Header="{Binding SelectedStoryResourceActionText}" Command="{Binding DeleteCurrentResourceCommand}" InputGestureText="Delete" />
                <MenuItem Header="查找" Command="{x:Static ApplicationCommands.Find}" InputGestureText="Ctrl+F" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="跟随系统" Command="{Binding ThemeSettings.UseSystemThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <MenuItem Header="浅色" Command="{Binding ThemeSettings.UseLightThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <MenuItem Header="深色" Command="{Binding ThemeSettings.UseDarkThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Separator />
                <MenuItem Header="资源浏览器" IsCheckable="True" IsChecked="{Binding IsResourceBrowserVisible, Mode=OneWay}" Command="{Binding ToggleResourceBrowserCommand}" />
                <MenuItem Header="底部面板" IsCheckable="True" IsChecked="{Binding BottomPanel.IsExpanded, Mode=OneWay}" Command="{Binding ToggleBottomPanelCommand}" />
            </MenuItem>
            <MenuItem Header="项目(_P)">
                <MenuItem Header="NameSpace 设置…" Command="{Binding ChangeGlobalNamespaceCommand}" />
                <MenuItem Header="新建故事…" Command="{Binding CreateStoryCommand}" />
                <MenuItem Header="引用故事包…" Command="{Binding ReferencePackageCommand}" AutomationProperties.AutomationId="ReferencePackage" />
                <MenuItem Header="导入故事包…" Command="{Binding ImportPackageCommand}" AutomationProperties.AutomationId="ImportPackage" />
                <MenuItem Header="导出故事包…" Command="{Binding ExportSelectedStoryPackageCommand}"
                          AutomationProperties.Name="导出故事包" AutomationProperties.AutomationId="ExportSelectedStoryPackage" />
                <MenuItem Header="准备 Runtime 重载" Command="{Binding PrepareRuntimeReloadCommand}" />
                <MenuItem Header="验证项目" Command="{Binding ValidateProjectCommand}" />
            </MenuItem>
            <MenuItem Header="帮助(_H)"><MenuItem Header="关于 DarkGrey RPG Studio" Command="{x:Static ApplicationCommands.Help}" /></MenuItem>
        </Menu>

        <Border Grid.Row="4" Padding="12,7"
                Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding ThemeSettings.PersistenceError, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ThemeSettings.HasPersistenceError, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <GridSplitter x:Name="BottomPanelSplitter" Grid.Row="2" Height="5"
               Cursor="SizeNS" DragCompleted="BottomPanelSplitter_OnDragCompleted"
               Background="{DynamicResource CardStrokeColorDefaultBrush}"
               HorizontalAlignment="Stretch" ResizeDirection="Rows">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BottomPanel.IsExpanded}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <Border Grid.Row="3" Height="{Binding BottomPanel.DockHeight}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <ListBox ItemsSource="{Binding BottomPanel.Tabs}" SelectedItem="{Binding BottomPanel.SelectedTab}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="BottomPanelTabBar_OnPreviewMouseLeftButtonDown"
                         MouseDoubleClick="BottomPanelTabBar_OnMouseDoubleClick">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="2,4,0,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <Border Margin="7,0,0,0" Padding="5,1" CornerRadius="8" Background="{DynamicResource SystemFillColorCriticalBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Page}" Value="Problems" />
                                                            <Condition Binding="{Binding DataContext.Problems.HasErrors, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Foreground="White" FontSize="10" Text="{Binding DataContext.Problems.ErrorCount, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="1" Margin="10,0,10,10">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding BottomPanel.IsExpanded}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border Padding="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding BottomPanel.SelectedTab.Page}" Value="Output"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <ListBox ItemsSource="{Binding Output.Entries}" BorderThickness="0" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,2">
                                        <TextBlock DockPanel.Dock="Left" Width="82" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                                        <TextBlock DockPanel.Dock="Left" Width="90" Text="{Binding Kind}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger></Style.Triggers></Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="8,0,0,0" TextWrapping="Wrap" Text="{Binding Message}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Border Padding="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding BottomPanel.SelectedTab.Page}" Value="Problems"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <ListView x:Name="ProblemList" ItemsSource="{Binding Problems.Problems}" BorderThickness="0" MouseDoubleClick="ProblemList_OnMouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="90" Header="严重性" DisplayMemberBinding="{Binding Severity}" />
                                    <GridViewColumn Width="180" Header="资源" DisplayMemberBinding="{Binding Source}" />
                                    <GridViewColumn Width="520" Header="问题" DisplayMemberBinding="{Binding DisplayMessage}" />
                                    <GridViewColumn Width="130" Header="字段" DisplayMemberBinding="{Binding Field}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <Border Padding="18" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding BottomPanel.SelectedTab.Page}" Value="Debugger"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="调试器将在后续阶段显示正在运行的任务和故事状态。" />
                    </Border>

                    <Border Padding="18" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding BottomPanel.SelectedTab.Page}" Value="Minecraft"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Minecraft 未连接" />
                            <TextBlock Margin="0,8,0,0" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="当前版本通过项目文件和 /dgrpg reload 与 Runtime 配合。&#x0a;Live Bridge 将在后续阶段加入。" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ResourceBrowserColumn" Width="260" MinWidth="0" MaxWidth="400" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ResourceBrowser" Grid.Column="0" Padding="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <DockPanel>
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding StoryWorkspace.HasStory}" Value="False" />
                                            <Condition Binding="{Binding IsCanonicalStoryWorkspaceVisible}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                            <Button DockPanel.Dock="Right" Width="32" Height="32" Padding="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Command="{Binding CreateStoryCommand}"
                                    AutomationProperties.Name="新建故事" ToolTip="新建故事">
                                <Viewbox Width="14" Height="14">
                                    <Path Width="12" Height="12" Data="M 1,6 L 11,6 M 6,1 L 6,11"
                                          Fill="Transparent" Stretch="None"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                            </Button>
                            <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="项目首页" />
                        </DockPanel>
                        <views:AnimatedPackageExpander DockPanel.Dock="Bottom" Header="引用故事包" Margin="0,12,0,0">
                            <views:AnimatedPackageExpander.Template>
                                <ControlTemplate TargetType="{x:Type views:AnimatedPackageExpander}">
                                    <StackPanel>
                                        <ToggleButton Padding="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="引用故事包" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                            <DockPanel><TextBlock DockPanel.Dock="Right"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="⌄"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="Text" Value="⌃"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{TemplateBinding Header}" /></DockPanel>
                                        </ToggleButton>
                                        <Border x:Name="PART_Reveal" Height="0" ClipToBounds="True">
                                            <ContentPresenter x:Name="PART_Content" Content="{TemplateBinding Content}" VerticalAlignment="Top" />
                                        </Border>
                                    </StackPanel>
                                </ControlTemplate>
                            </views:AnimatedPackageExpander.Template>
                            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ReferencedPackages}" AutomationProperties.Name="引用故事包区域">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Command="{Binding SelectCommand}" HorizontalContentAlignment="Left" Margin="0,4" Padding="10" Content="{Binding Label}">
                                            <Button.ContextMenu><ContextMenu><MenuItem Header="移除引用故事包" Command="{Binding RemoveCommand}" /></ContextMenu></Button.ContextMenu>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </views:AnimatedPackageExpander>
                        <TextBox x:Name="StorySearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,5"
                                 AutomationProperties.Name="搜索故事" ToolTip="按 ID、显示名称或标签搜索"
                                 Text="{Binding ProjectHome.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasProject}" Value="True" /><Condition Binding="{Binding ProjectHome.IsEmptyProject}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding ProjectHome.EmptyStateTitle}" />
                            <TextBlock Margin="0,5,0,0" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ProjectHome.EmptyStateDescription}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasProject}" Value="True" /><Condition Binding="{Binding ProjectHome.IsSearchNoResults}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding ProjectHome.SearchNoResultsTitle}" />
                            <Button Margin="0,8,0,0" Padding="8,4" Command="{Binding ProjectHome.ClearSearchCommand}" Content="清空搜索" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="请先从“文件”菜单新建或打开项目。">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasProject}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <ListBox x:Name="StoryList" ItemsSource="{Binding ProjectHome.FilteredStories}" SelectedItem="{Binding ProjectHome.SelectedStory}"
                                 BorderThickness="0" HorizontalContentAlignment="Stretch" MouseDoubleClick="StoryList_OnMouseDoubleClick"
                                 PreviewMouseLeftButtonDown="StoryList_OnPreviewMouseLeftButtonDown"
                                 PreviewMouseRightButtonDown="StoryList_OnPreviewMouseRightButtonDown"
                                 AutomationProperties.Name="故事导航列表"
                                 Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasProject}" Value="True" /><Condition Binding="{Binding ProjectHome.HasFilteredStories}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5,7">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Id}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TagsText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <DockPanel>
                        <DockPanel.Style>
                            <Style TargetType="DockPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding StoryWorkspace.HasStory}" Value="True" /><Condition Binding="{Binding IsCanonicalStoryWorkspaceVisible}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style>
                        </DockPanel.Style>
                        <Button DockPanel.Dock="Top" Margin="0,0,0,12" Padding="8,6" HorizontalContentAlignment="Left" Command="{Binding ShowProjectHomeCommand}" Content="← 返回项目首页" />
                        <TextBlock DockPanel.Dock="Top" FontSize="17" FontWeight="SemiBold" Text="{Binding StoryWorkspace.StoryDisplayName}" TextWrapping="Wrap" />
                        <TextBlock DockPanel.Dock="Top" Margin="0,3,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StoryWorkspace.StoryId}" />
                        <ListBox ItemsSource="{Binding StoryWorkspace.Routes}" SelectedItem="{Binding StoryWorkspace.SelectedRoute, Mode=TwoWay}"
                                 BorderThickness="0" HorizontalContentAlignment="Stretch" Background="Transparent"
                                 AutomationProperties.Name="故事页面列表">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9" /><Setter Property="Margin" Value="0,2" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" /></Trigger></Style.Triggers></Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><TextBlock FontWeight="SemiBold" Text="{Binding Title}" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                </Grid>
            </Border>

            <GridSplitter x:Name="ResourceBrowserSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource CardStrokeColorDefaultBrush}"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2" Margin="12" Padding="18"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasProject}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center" FontSize="26" FontWeight="SemiBold" Text="DarkGrey RPG Studio" />
                        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="从“文件”菜单新建或打开项目。" />
                    </StackPanel>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasProject}" Value="True" /><Condition Binding="{Binding StoryWorkspace.HasStory}" Value="False" /><Condition Binding="{Binding IsCanonicalStoryWorkspaceVisible}" Value="False" /><Condition Binding="{Binding ProjectHome.IsHomeVisible}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style>
                        </Grid.Style>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Width="116" Height="34" Command="{Binding OpenSelectedStoryCommand}"
                                    Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="进入选中故事" Content="进入故事" />
                            <StackPanel>
                                <TextBlock FontSize="26" FontWeight="SemiBold" Text="项目故事图谱" />
                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="左侧选择故事，中央编辑故事关系，右侧查看当前故事详情。" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                            <views:ProjectGraphView DataContext="{Binding ProjectHome.Graph}" />
                            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                            <Border Grid.Column="2" Padding="16" Background="{DynamicResource LayerFillColorAltBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                <Grid><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding ProjectHome.SelectedStory.Overview}">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.SelectedReferencedPackage, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="故事详情" />
                                    <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding DisplayName}"
                                               TextWrapping="Wrap" AutomationProperties.Name="选中故事完整概览" />
                                    <TextBlock Margin="0,4,0,18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Id}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding DataContext.HomeResourceFolders, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Expander Header="{Binding DisplayName}" IsExpanded="False" IsEnabled="{Binding HasResources}"
                                                      Style="{StaticResource ReferenceFolderExpanderStyle}" Margin="0,2">
                                                <ListBox ItemsSource="{Binding Items}" Margin="10,2,0,6" BorderThickness="0"
                                                         Background="Transparent" HorizontalContentAlignment="Stretch"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="6,4"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <EventSetter Event="MouseDoubleClick" Handler="HomeResource_OnMouseDoubleClick"/>
                                                    </Style></ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate><DataTemplate>
                                                        <TextBlock ToolTip="{Binding ToolTip}" TextAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                            <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding IdentityText, Mode=OneWay}" FontSize="11"/>
                                                        </TextBlock>
                                                    </DataTemplate></ListBox.ItemTemplate>
                                                </ListBox>
                                            </Expander>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel></ScrollViewer>
                                <ScrollViewer Background="{DynamicResource LayerFillColorAltBrush}" VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedReferencedPackage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                                    <StackPanel DataContext="{Binding SelectedReferencedPackage}">
                                        <TextBlock Text="引用故事包" FontSize="12" />
                                        <TextBlock Text="{Binding Label}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                        <Button Content="故事流程图" Command="{Binding StoryGraphCommand}" Margin="0,0,0,12" Padding="10,6" />
                                        <TextBlock Text="资源（只读）" FontWeight="SemiBold" Margin="0,4,0,8" />
                                        <ItemsControl ItemsSource="{Binding Folders}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Expander Margin="0,2" Header="{Binding DisplayName}" IsExpanded="False"
                                                          IsEnabled="{Binding HasResources}" Style="{StaticResource ReferenceFolderExpanderStyle}"
                                                          AutomationProperties.Name="{Binding DisplayName}">
                                                    <ItemsControl Margin="10,2,0,6" ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate><DataTemplate>
                                                            <Button Margin="0,1" Padding="6,4" HorizontalContentAlignment="Stretch"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                                                    MouseDoubleClick="ReferencedResource_OnMouseDoubleClick">
                                                                <TextBlock TextAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                                    <Run Text="{Binding Resource.DisplayName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Resource.Id, Mode=OneWay}" FontSize="11"/>
                                                                </TextBlock>
                                                            </Button>
                                                        </DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </ScrollViewer></Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid>
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /></Style></Grid.Style>
                    </Grid>

                    <Grid>
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsCanonicalStoryWorkspaceVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <graphViews:CanonicalStoryWorkspaceView Workspace="{Binding CanonicalStoryWorkspace}" />
                    </Grid>

                    <Grid>
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding StoryWorkspace.HasStory}" Value="True" /><Condition Binding="{Binding IsCanonicalStoryWorkspaceVisible}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.RowDefinitions><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid>
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding StoryWorkspace.CurrentRoute}" Value="Actors"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,12" AutomationProperties.Name="Story 角色页面命令栏" AutomationProperties.AutomationId="StoryActorCommandBar">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock MaxWidth="220" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding StoryWorkspace.StoryDisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="/ 角色" />
                                    <TextBox Grid.Column="2" MinWidth="80" Padding="8,5" VerticalContentAlignment="Center" AutomationProperties.Name="搜索故事角色" Text="{Binding StoryWorkspace.Actors.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StoryWorkspace.Actors.FilteredMemberships.Count, StringFormat={}{0} 个角色}" AutomationProperties.Name="当前过滤角色数量" />
                                    <StackPanel Grid.Column="4" Margin="12,0,0,0" Orientation="Horizontal">
                                        <Button MinWidth="88" Height="32" Margin="0,0,8,0" Command="{Binding NewActorCommand}" Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="创建角色" Content="+ 创建" />
                                        <Button MinWidth="76" Height="32" Command="{Binding ReferenceActorCommand}" AutomationProperties.Name="引用角色" Content="引用" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding StoryResourceLibraryWidth, ElementName=RootWindow, Mode=TwoWay}" MinWidth="220" MaxWidth="380" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid>
                                        <ListBox ItemsSource="{Binding StoryWorkspace.Actors.FilteredMemberships}"
                                                 SelectedItem="{Binding SelectedStoryActor, Mode=TwoWay}"
                                                 ItemTemplate="{StaticResource StoryActorMembershipTemplate}"
                                                 BorderThickness="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="故事角色列表"
                                                 ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </Grid>
                                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="调整 Story 角色资源库宽度" />
                                    <Border Grid.Column="2" Padding="16" Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="4">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="选择本故事中的角色开始编辑。">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentActor}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                                <ContentControl Content="{Binding CurrentActor}" ContentTemplate="{StaticResource ActorEditorTemplate}">
                                                    <ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></ContentControl.Style>
                                                </ContentControl>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button MinWidth="96" Height="32" Margin="0,0,8,0" Command="{Binding ViewActorReferencesCommand}" Content="查看引用" />
                                                <Button MinWidth="96" Height="32" Margin="0,0,8,0" Command="{Binding RemoveActorReferenceCommand}" Content="解除引用" />
                                                <Button MinWidth="96" Height="32" Command="{Binding DeleteActorCommand}" Content="删除资源" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Grid>
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding StoryWorkspace.CurrentRoute}" Value="Dialogues"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,12" AutomationProperties.Name="Story 对话页面命令栏" AutomationProperties.AutomationId="StoryDialogueCommandBar">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock MaxWidth="220" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding StoryWorkspace.StoryDisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="/ 对话" />
                                    <TextBox Grid.Column="2" MinWidth="80" Padding="8,5" VerticalContentAlignment="Center" AutomationProperties.Name="搜索 Dialogue" Text="{Binding StoryWorkspace.Dialogues.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StoryWorkspace.Dialogues.FilteredItems.Count, StringFormat={}{0} 个对话}" AutomationProperties.Name="当前过滤对话数量" />
                                    <StackPanel Grid.Column="4" Margin="12,0,0,0" Orientation="Horizontal"><Button MinWidth="88" Height="32" Margin="0,0,8,0" Command="{Binding NewStoryResourceCommand}" Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="创建 Dialogue" Content="+ 创建" /><Button MinWidth="104" Height="32" Margin="0,0,8,0" Command="{Binding DuplicateStoryResourceCommand}" AutomationProperties.Name="从现有复制 Dialogue" Content="从现有复制" /><Button MinWidth="76" Height="32" Command="{Binding ReferenceStoryResourceCommand}" AutomationProperties.Name="引用 Dialogue" Content="引用" /></StackPanel>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding StoryResourceLibraryWidth, ElementName=RootWindow, Mode=TwoWay}" MinWidth="220" MaxWidth="380" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid><ListBox PreviewMouseRightButtonDown="StoryResourceList_OnPreviewMouseRightButtonDown" ItemsSource="{Binding StoryWorkspace.Dialogues.FilteredItems}" SelectedItem="{Binding SelectedStoryResource, Mode=TwoWay}" ItemTemplate="{StaticResource StoryResourceMembershipTemplate}" BorderThickness="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="故事 Dialogue 列表" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style></ListBox.ItemContainerStyle></ListBox></Grid>
                                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="调整 Story 对话资源库宽度" />
                                    <Border Grid.Column="2" Padding="16" Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="4"><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="选择对话开始编辑。"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentDialogue}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding CurrentDialogue}" ContentTemplate="{StaticResource DialogueEditorTemplate}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></ContentControl.Style></ContentControl></Grid><StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button MinWidth="96" Height="32" Margin="0,0,8,0" Command="{Binding ViewStoryResourceReferencesCommand}" Content="查看引用" /><Button MinWidth="96" Height="32" Margin="0,0,8,0" Command="{Binding RemoveStoryResourceReferenceCommand}" Content="解除引用" /><Button MinWidth="96" Height="32" Command="{Binding DeleteStoryResourceCommand}" Content="{Binding SelectedStoryResourceActionText}" /></StackPanel></Grid></Border>
                                </Grid>
                            </Grid>

                            <Grid>
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding StoryWorkspace.CurrentRoute}" Value="Quests"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,12" AutomationProperties.Name="Story 任务页面命令栏" AutomationProperties.AutomationId="StoryQuestCommandBar">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock MaxWidth="220" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding StoryWorkspace.StoryDisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="/ 任务" />
                                    <TextBox Grid.Column="2" MinWidth="80" Padding="8,5" VerticalContentAlignment="Center" AutomationProperties.Name="搜索 Quest" Text="{Binding StoryWorkspace.Quests.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StoryWorkspace.Quests.FilteredItems.Count, StringFormat={}{0} 个任务}" AutomationProperties.Name="当前过滤任务数量" />
                                    <StackPanel Grid.Column="4" Margin="12,0,0,0" Orientation="Horizontal"><Button MinWidth="88" Height="32" Margin="0,0,8,0" Command="{Binding NewStoryResourceCommand}" Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="创建 Quest" Content="+ 创建" /><Button MinWidth="104" Height="32" Margin="0,0,8,0" Command="{Binding DuplicateStoryResourceCommand}" AutomationProperties.Name="从现有复制 Quest" Content="从现有复制" /><Button MinWidth="76" Height="32" Command="{Binding ReferenceStoryResourceCommand}" AutomationProperties.Name="引用 Quest" Content="引用" /></StackPanel>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding StoryResourceLibraryWidth, ElementName=RootWindow, Mode=TwoWay}" MinWidth="220" MaxWidth="380" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid><ListBox PreviewMouseRightButtonDown="StoryResourceList_OnPreviewMouseRightButtonDown" ItemsSource="{Binding StoryWorkspace.Quests.FilteredItems}" SelectedItem="{Binding SelectedStoryResource, Mode=TwoWay}" ItemTemplate="{StaticResource StoryResourceMembershipTemplate}" BorderThickness="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="故事 Quest 列表" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style></ListBox.ItemContainerStyle></ListBox></Grid>
                                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="调整 Story 任务资源库宽度" />
                                    <Border Grid.Column="2" Padding="16" Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="4"><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="选择任务开始编辑。"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentQuest}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding CurrentQuest}" ContentTemplate="{StaticResource QuestEditorTemplate}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></ContentControl.Style></ContentControl></Grid><StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button MinWidth="96" Height="32" Margin="0,0,8,0" Command="{Binding ViewStoryResourceReferencesCommand}" Content="查看引用" /><Button MinWidth="96" Height="32" Margin="0,0,8,0" Command="{Binding RemoveStoryResourceReferenceCommand}" Content="解除引用" /><Button MinWidth="96" Height="32" Command="{Binding DeleteStoryResourceCommand}" Content="{Binding SelectedStoryResourceActionText}" /></StackPanel></Grid></Border>
                                </Grid>
                            </Grid>

                            <Grid>
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding StoryWorkspace.CurrentRoute}" Value="Flow"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <views:StoryFlowEditorView DataContext="{Binding CurrentFlow}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
        <Border Margin="0,24,24,0" Padding="14,10" MaxWidth="480"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Toast.IsVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        <DataTrigger Binding="{Binding Toast.Kind}" Value="Warning"><Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Toast.Kind}" Value="Error"><Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="28" Height="28" Margin="12,0,0,0" Click="DismissToast_OnClick" Content="×" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Toast.Message}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
