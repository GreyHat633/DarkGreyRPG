<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DarkGreyRPG.Studio.Core\DarkGreyRPG.Studio.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>Assets\DarkGreyRPGStudio.ico</ApplicationIcon>
    <AssemblyName>DarkGreyRPGStudio</AssemblyName>
    <Version>0.3.3.1</Version>
    <AssemblyVersion>0.3.3.1</AssemblyVersion>
    <FileVersion>0.3.3.1</FileVersion>
    <InformationalVersion>0.3.3.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>DarkGrey RPG Studio</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\DarkGreyRPGStudio.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\.tooling\media-tools\ffmpeg\ffmpeg.exe;..\..\..\.tooling\media-tools\ffmpeg\ffprobe.exe;..\..\..\.tooling\media-tools\ffmpeg\LICENSE;..\..\..\.tooling\media-tools\ffmpeg\README.txt">
      <Link>media-tools\ffmpeg\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
