<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DarkGreyRPG.Studio.Core\DarkGreyRPG.Studio.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>Assets\DarkGreyRPGStudio.ico</ApplicationIcon>
    <AssemblyName>DarkGreyRPGStudio</AssemblyName>
    <Version>0.3.3.7</Version>
    <AssemblyVersion>0.3.3.7</AssemblyVersion>
    <FileVersion>0.3.3.7</FileVersion>
    <InformationalVersion>0.3.3.7</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>DarkGrey RPG Studio</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <MediaToolsDirectory Condition="'$(MediaToolsDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\..\.tooling\media-tools\ffmpeg</MediaToolsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\DarkGreyRPGStudio.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(MediaToolsDirectory)\ffmpeg.exe;$(MediaToolsDirectory)\ffprobe.exe;$(MediaToolsDirectory)\LICENSE;$(MediaToolsDirectory)\README.txt">
      <Link>Tools\FFmpeg\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
